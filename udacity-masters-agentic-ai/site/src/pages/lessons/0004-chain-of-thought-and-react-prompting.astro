const roleGoal = `You are a Supply Chain Logistics Coordinator. Your goal is to diagnose shipment delays by gathering information from different systems.`.trim();

const thinkActCycle = `
You must use a step-by-step reasoning process. For each step, respond with a single THINK/ACT message.

THINK: First, you will reason about the problem and determine the next logical action to take.
ACT: Based on your thought process, you will call ONE of the available tools.
`.trim();

const toolDefinitions = `
## Available Tools

1. get_shipment_status(tracking_id: str)
   - Use this to get the last known location and status of a shipment.
   - Example Input:  ACT: get_shipment_status(tracking_id="XYZ123")
   - Example Output: OBSERVE: {"status": "Delayed", "location": "Chicago Rail Yard"}

2. check_facility_alerts(facility_name: str)
   - Use this to check for operational alerts (e.g., weather delays, closures) at a specific facility.
   - Example Input:  ACT: check_facility_alerts(facility_name="Chicago Rail Yard")
   - Example Output: OBSERVE: {"alert": "Severe Weather Alert: All operations suspended."}

3. final_answer(summary: str)
   - Use this tool ONLY when you have diagnosed the problem and can provide a complete summary.
   - Example Input: ACT: final_answer(summary="Shipment XYZ123 is delayed in Chicago due to a severe weather-related closure at the rail yard.")
`.trim();

const workedExample = `
User: Find out why shipment XYZ123 is delayed.

AI Assistant:
THINK: I need to find out why shipment XYZ123 is delayed. My first step is to get the
current status and location of the shipment using the get_shipment_status tool.
ACT: get_shipment_status(tracking_id="XYZ123")

(System provides OBSERVE: {"status": "Delayed", "location": "Chicago Rail Yard"}
and the AI continues...)
`.trim();

const cotSystemPrompts = `
# With explicit CoT
You are a meticulous Retail Demand Analyst.
Your task is to analyze provided sales data and promotion schedules to identify
and explain significant sales spikes for specific SKUs.

Think step by step.

# Without explicit CoT: identical, minus the last line
`.trim();

const developedCotPrompt = `
## INSTRUCTIONS:
Analyze the data provided below and hypothesize causes for any observed sales spikes.
- Find all sales spikes for each product
- For each: date, amount and percentage increase, possible causes
  (sales data, promotions, weather, competitor pricing)
- Start with your analysis, then conclude with the single largest spike
  by percentage increase, with a short explanation

## OUTPUT FORMAT:
STRUCTURED ANALYSIS:
[Structured Analysis]

LARGEST SPIKE:
\`\`\`json
{
    "date": "YYYY-MM-DD",
    "amount_before_increase": "X.XX",
    "amount_after_increase": "X.XX",
    "percentage_increase": "X.XX%",
    "causes": ["Cause 1", "Cause 2", "Cause 3"]
}
\`\`\`

## CONTEXT
Sales Data: ...   Promotions Calendar: ...   Weather Data: ...   Competitor Pricing Data: ...
`.trim();

const fstringBug = `
user_prompt = f"""
...
\`\`\`json
{                         # ❌ f-string treats this as a Python expression
    "date": "YYYY-MM-DD", # → ValueError: Invalid format specifier
}
\`\`\`
Sales Data:
{sales_data}              # ✅ this one SHOULD be substituted
"""

# Fix: double the literal braces, keep single braces for real placeholders
\`\`\`json
{{
    "date": "YYYY-MM-DD",
}}
\`\`\`
`.trim();

const formatReminder = `
...
Competitor Pricing Data:
{competitor_pricing_data}

---

Remember: end your response with the LARGEST SPIKE section containing a \`\`\`json
code block exactly as specified in OUTPUT FORMAT.
`.trim();

const reactTools = `
calculator(expression: str)        → arithmetic, e.g. calculator(expression="(10 + 20) / 2.0")
get_sales_data()                   → the sales rows
call_weather_api(date: str)        → weather for one date ("call this for the date of each spike")
final_answer(amount_after_spike: str, causes: list[str], date: str, percentage_spike: str)
                                   → ends the loop with a structured answer
`.trim();

const reactResponseFormat = `
THINK:
[reasoning that doesn't need a tool]
[conclusion: which tool to call next, and why]
ACT:
[one tool call with arguments]
`.trim();

const reactParser = String.raw`
WEATHER_REGEX      = r"ACT:\ncall_weather_api\(date=\"(.*)\"\)"
CALCULATOR_REGEX   = r"ACT:\ncalculator\(expression=\"(.*)\"\)"
FINAL_ANSWER_REGEX = r"ACT:\nfinal_answer\(amount_after_spike=\"(.*)\", causes=(.*), date=\"(.*)\", percentage_spike=\"(.*)\"\)"

def get_observation_message(response: str) -> str:
    if re.search(WEATHER_REGEX, response):
        date = re.search(WEATHER_REGEX, response).groups()[0]
        return f"OBSERVE:\n{call_weather_api(date)}"
    elif re.search(CALCULATOR_REGEX, response):
        expression = re.search(CALCULATOR_REGEX, response).groups()[0]
        return f"OBSERVE:\n{calculator(expression)}"
    # ... get_sales_data, final_answer (causes parsed with ast.literal_eval)
    else:
        # Don't crash: tell the model, so it can correct itself next step
        return "OBSERVE:\nInvalid tool call or tool not supported."
`.trim();

const reactLoop = String.raw`
messages = [
    {"role": "system", "content": react_system_prompt},
    {"role": "user",   "content": user_prompt_analyze},
]
num_react_steps = 0

while True:
    react_response = get_completion(messages=messages, model=MODEL, client=client)  # THINK + ACT
    observation_message = get_observation_message(react_response)                    # run the tool

    messages.append({"role": "assistant", "content": react_response})
    messages.append({"role": "user",      "content": observation_message})          # OBSERVE

    if "ACT:\nfinal_answer" in react_response:   # exit 1: the model says it's done
        break

    num_react_steps += 1
    if num_react_steps > 10:                     # exit 2: safety limit
        print("ERROR: Max number of React steps exceeded. Breaking.")
        break
`.trim();

const mindMap = `
# Chain-of-Thought & ReAct
## ReAct system prompt
### Role and goal
### THINK/ACT format
### Tool definitions + examples
### Complete example interaction
## Model vs. harness
### CoT — one completion
### ReAct — needs the agent loop
### ACT is only text
## Exercise Part I — CoT
### Simple: with vs. without the phrase
### Developed: instructions + output format
### Format ignored → restate it last
### f-string braces → double them
### Valid JSON ≠ correct causes
## Exercise Part II — ReAct loop
### Tools described as text
### Parser — regex on ACT
### Executor — real function → OBSERVE
### Loop — final_answer or max steps
### Errors returned as observations
### safe_eval, not eval
`.trim();
---

<LessonLayout title="2.1 — Chain-of-Thought & ReAct Prompting">

  <LessonHeader
    num="2.1"
    title="Chain-of-Thought & ReAct Prompting"
    subtitle="Structuring a ReAct system prompt, then the Demand-Spike Detective exercise: CoT prompting (Part I) and a working ReAct loop (Part II)."
  />

  <div class="lesson-content">

    <p>
      The ReAct technique needs a comprehensive system prompt that teaches the agent
      how to use the ReAct framework — this single prompt sets the rules, defines the
      tools, and teaches the model how to "think." A good ReAct system prompt has four
      parts.
    </p>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Part</th><th>Answers</th></tr>
        </thead>
        <tbody>
          <tr><td>Role and Goal</td><td>Who is the agent? What is its purpose?</td></tr>
          <tr><td>THINK/ACT Instruction</td><td>How must the agent format its reasoning and actions?</td></tr>
          <tr><td>Tool Definitions</td><td>What tools can the agent use, and how do they work?</td></tr>
          <tr><td>Complete Example</td><td>A full example of a multi-turn interaction.</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="lesson-heading">1. Define the Role and Goal <SourceBadge source="course" /></h2>

    <p>Tell the agent its identity and overall mission.</p>

    <p><em>Scenario used throughout: an AI agent helping a logistics coordinator track a delayed shipment.</em></p>

    <CodeBlock lang="text" label="role-and-goal" code={roleGoal} />

    <h2 class="lesson-heading">2. The THINK/ACT Cycle <SourceBadge source="course" /></h2>

    <p>
      Give the agent explicit instructions on how to structure its response — the core
      of the ReAct framework.
    </p>

    <CodeBlock lang="text" label="think-act-cycle" code={thinkActCycle} />

    <h2 class="lesson-heading">3. Define the Available Tools <SourceBadge source="course" /></h2>

    <p>
      List every tool the agent can use. For each: name, parameters, a short
      description, and an example of its input (<code>ACT</code>) and output
      (<code>OBSERVE</code>).
    </p>

    <CodeBlock lang="text" label="tool-definitions" code={toolDefinitions} />

    <h2 class="lesson-heading">4. A Complete Example Interaction <SourceBadge source="course" /></h2>

    <p>
      Put it together by showing the agent a full, multi-step example of how to use
      these components to solve a problem — this few-shot example is often the most
      effective way for the agent to learn the pattern.
    </p>

    <CodeBlock lang="text" label="worked-example" code={workedExample} />

    <h2 class="lesson-heading">What's Actually Happening: Model vs. Harness <SourceBadge source="course" /></h2>

    <p>
      It's worth separating <strong>Chain-of-Thought</strong> from <strong>ReAct</strong>
      here, because they don't need the same amount of machinery.
    </p>

    <p>
      An LLM is an autoregressive next-token predictor — every token it generates gets
      appended back into its own context and conditions the <em>next</em> token. Saying
      "think step by step" doesn't trigger a separate reasoning module; it just gets the
      model to emit more tokens (a written-out scratchpad) before its final answer. Because
      those intermediate tokens become part of the input for predicting the rest, the final
      answer ends up conditioned on a worked-through trace instead of a jump straight to
      the answer. That's the whole mechanism — and it happens inside <strong>one</strong>
      completion. No loop, no tool calls, no harness required.
    </p>

    <p>
      ReAct breaks from that at exactly one point: the <code>ACT</code> step. When the
      model outputs <code>ACT: get_shipment_status(tracking_id="XYZ123")</code>, that's
      just text — the model has no database connection and can't execute anything. It's
      predicting what a plausible tool call looks like, not performing one. Something
      outside the model has to actually run the tool, take the real return value, and feed
      it back in as <code>OBSERVE: ...</code> before the model is called again for the next
      <code>THINK</code>. That "something" is the harness — the agent loop from lesson
      1.1's four-step cycle (Think → Act → Observe → loop back). The model is stateless
      between calls; it only ever knows what's sitting in the messages array you hand it
      next.
    </p>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Technique</th><th>Needs a harness?</th><th>Why</th></tr>
        </thead>
        <tbody>
          <tr><td>Chain-of-Thought</td><td>No</td><td>Reasoning tokens condition the same completion — no external step required.</td></tr>
          <tr><td>ReAct</td><td>Yes</td><td>The <code>ACT</code> step needs a real tool call executed outside the model, with the real result re-injected as <code>OBSERVE</code>.</td></tr>
        </tbody>
      </table>
    </div>

    <LessonCallout variant="info" title="Not reasoning in a separate sense">
      <p>
        The model isn't reasoning apart from its token prediction — CoT/ReAct prompting
        just <em>structures</em> that prediction into visible intermediate steps. ReAct
        additionally makes some of those steps genuinely load-bearing (the
        <code>OBSERVE</code> results are real, not hallucinated) because the harness
        intercepts <code>ACT</code> and substitutes ground truth before the model
        continues.
      </p>
    </LessonCallout>

    <LessonCallout variant="key" title="Remember">
      <p>
        A ReAct system prompt is Role/Goal + THINK/ACT format + Tool Definitions + a
        Complete Example, combined — that's what gives the agent everything it needs to
        begin the task. And structurally: CoT lives entirely inside one LLM call; ReAct
        needs the surrounding agent loop to make <code>ACT</code> real.
      </p>
    </LessonCallout>

    <h2 class="lesson-heading">Exercise: Demand-Spike Detective (CoT) <SourceBadge source="course" /></h2>

    <p>
      Guide an LLM to explain an unexpected sales spike using Chain-of-Thought only, with no
      tools. The model gets four synthetic datasets pasted directly into the prompt:
    </p>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Dataset</th><th>What's in it</th></tr>
        </thead>
        <tbody>
          <tr><td>Sales</td><td>Daily quantity and revenue for 5 products, 2024-01-10 to 2024-01-16</td></tr>
          <tr><td>Promotions</td><td>Weekend Special (10% off P002, Jan 12–14); Flash Sale (15% off P001/P003/P005, Jan 15–16)</td></tr>
          <tr><td>Weather</td><td>Daily temperature and conditions; heavy rain and a flood warning on Jan 12</td></tr>
          <tr><td>Competitor pricing</td><td>Our price vs. three competitors' prices and discounts per product per day</td></tr>
        </tbody>
      </table>
    </div>

    <p>
      Looking at the data yourself first, the answer is that <strong>Product 5 spiked on
      2024-01-12</strong> (342 units vs. roughly 100 on other days). The Weekend Special that started
      that day was for Product 2, not Product 5. It rained heavily that day, and a competitor
      dropped its price on Product 5. A good analysis should find the spike and weigh these factors
      without overclaiming.
    </p>

    <h3 class="lesson-heading">Part 1: Simple CoT, with vs. without the phrase</h3>

    <p>
      Send the same data twice. The only difference is whether the system prompt asks the model to
      think step by step. Compare the two responses.
    </p>

    <CodeBlock lang="text" label="system-prompts" code={cotSystemPrompts} />

    <LessonCallout variant="info" title="Modern models may not need the phrase">
      <p>
        Many current LLMs already reason in steps because that behavior was trained in. Run your
        prompts with and without the explicit phrase, and run each more than once, since results
        vary between runs.
      </p>
    </LessonCallout>

    <h3 class="lesson-heading">Part 2: A more developed CoT prompt</h3>

    <p>
      Add an <strong>instructions</strong> section listing the steps to follow and an
      <strong>output format</strong> section. The steps steer the reasoning, and the format
      constrains the output so code can parse it. Here, the final answer is a JSON block describing
      the single largest spike.
    </p>

    <CodeBlock lang="markdown" label="developed-cot-prompt" code={developedCotPrompt} />

    <p>
      The notebook then splits the response on <code>```json</code>: everything before it is
      the analysis, and the block is parsed with <code>json.loads</code>.
    </p>

    <h2 class="lesson-heading">Running the Exercise: What Went Wrong <SourceBadge source="course" /></h2>

    <p>Three separate problems came up, and each teaches something different.</p>

    <h3 class="lesson-heading">1. The model ignored the output format</h3>

    <p>
      With gpt-4.1-nano, the response went "Step 1" through "Step 7", then a summary, and stopped.
      There was no <code>LARGEST SPIKE</code> section, no JSON block, and no single largest spike,
      so the parser raised <code>❌ No LARGEST SPIKE found in response</code>. This was not a JSON
      parsing error: the block never existed. Likely causes:
    </p>

    <ul>
      <li><strong>Smallest model.</strong> Nano is the weakest of the three at following format instructions.</li>
      <li><strong>Format buried mid-prompt.</strong> The format spec came before thousands of tokens of data, so the data was freshest when the model started writing.</li>
      <li><strong>"Think in steps" took over.</strong> Once it wrote "Step 1:", each step conditioned the next, and it followed its own structure instead of the requested one.</li>
      <li><strong>Temperature 0.7.</strong> Outcomes vary from run to run.</li>
    </ul>

    <p>Fix: repeat the format requirement at the very end of the prompt, after the data.</p>

    <CodeBlock lang="text" label="format-reminder" code={formatReminder} />

    <p>
      With the reminder (and the brace fix below), three runs in a row on gpt-4.1-nano all produced
      parseable JSON: <code>2024-01-12</code>, 114 → 342, <code>200.00%</code>. If it still fails,
      re-run it or switch to gpt-4.1-mini.
    </p>

    <h3 class="lesson-heading">2. A Python bug: braces in an f-string</h3>

    <p>
      The prompt is an f-string so the datasets can be substituted in. Inside an f-string,
      <code>&#123; ... &#125;</code> means "evaluate this as Python", so the JSON template's braces
      crash the cell before the model is ever called:
    </p>

    <CodeBlock lang="python" label="fstring-braces.py" code={fstringBug} />

    <h3 class="lesson-heading">3. Correct format, wrong reasoning</h3>

    <p>
      Once the JSON parsed, the <code>causes</code> still contained errors. Two of three runs blamed
      the "Weekend Special" promotion, which only applied to Product 2. One run described the
      weather as "stable" on a day with heavy rain and a flood warning. The model found the right
      spike and reported it in the right format, but the explanation was partly made up.
    </p>

    <LessonCallout variant="key" title="Takeaways">
      <p>
        <strong>Format compliance and correctness are separate checks.</strong> Valid JSON tells
        you nothing about whether the causes are true. Put format requirements last, after any
        large data, so they're the freshest instruction. Validate the output in code, since the
        model won't always comply. And when a "parsing error" appears, check whether the
        expected block exists at all before debugging the parser.
      </p>
    </LessonCallout>

    <h2 class="lesson-heading">Exercise Part II: Building the ReAct Loop <SourceBadge source="course" /></h2>

    <p>
      Same task, finding and explaining the sales spike, but now the data isn't pasted into
      the prompt. The model asks for what it needs through tools, and your code runs them. This
      matters when the full dataset is too big or complex for one prompt.
    </p>

    <p>A ReAct agent needs four parts:</p>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Part</th><th>What it does</th><th>In the notebook</th></tr>
        </thead>
        <tbody>
          <tr><td>Tools described as text</td><td>The system prompt tells the model what it can call and how</td><td>Name, arguments, and an example <code>ACT</code>/<code>OBSERVE</code> per tool</td></tr>
          <tr><td>Parser</td><td>Turns the model's <code>ACT:</code> text into a function call</td><td><code>get_observation_message()</code>, using regex</td></tr>
          <tr><td>Executor</td><td>Runs the real function and wraps the result as <code>OBSERVE:</code></td><td>Same function; calls <code>calculator</code>, <code>call_weather_api</code>, …</td></tr>
          <tr><td>Loop with break conditions</td><td>Repeats think → act → observe until done</td><td><code>while True</code>, exits on <code>final_answer</code> or after 10 steps</td></tr>
        </tbody>
      </table>
    </div>

    <h3 class="lesson-heading">1. Tools and response format in the system prompt</h3>

    <CodeBlock lang="text" label="available-tools" code={reactTools} />

    <p>
      The model must reply with exactly one THINK/ACT pair per turn, and it's told "ALWAYS provide
      a tool call after ACT:, else you will fail." The final answer is itself a tool call:
      <code>final_answer(...)</code>. That gives the loop a clear stop signal and returns the result
      in a structured, parseable form.
    </p>

    <CodeBlock lang="text" label="response-format" code={reactResponseFormat} />

    <h3 class="lesson-heading">2. Parse the ACT line and run the tool</h3>

    <CodeBlock lang="python" label="get_observation_message.py" code={reactParser} />

    <p>
      The calculator uses <code>safe_eval</code>, which parses the expression with
      <code>ast</code> and allows only <code>+ - * /</code> and negation, never <code>eval()</code>. The
      model writes the arguments, so treat them as untrusted input.
    </p>

    <h3 class="lesson-heading">3. The loop</h3>

    <CodeBlock lang="python" label="react-loop.py" code={reactLoop} />

    <p>Things that are easy to miss:</p>

    <ul>
      <li><strong>The message list is the agent's memory.</strong> The model keeps nothing between calls. Each turn appends its THINK/ACT as <code>assistant</code> and the tool result as <code>user</code>, and the whole list is sent again on every call.</li>
      <li><strong>Both break conditions are needed.</strong> <code>final_answer</code> is the normal exit. The step limit protects against an agent that never finishes, which would otherwise keep calling the API and spending money.</li>
      <li><strong>Errors become observations.</strong> An unparseable or unknown tool call returns <code>"Invalid tool call…"</code> instead of raising, so the model sees the mistake and can retry.</li>
      <li><strong>The model only writes text.</strong> <code>ACT: call_weather_api(...)</code> is a request. Real data enters only because your code runs the function and inserts the result.</li>
    </ul>

    <p>
      The run is checked with <code>assert "date: 2024-01-12"</code> and
      <code>"percentage_spike: 200"</code> in the final observation: the same spike Part I found,
      reached through tool calls and the calculator instead of mental math over pasted data.
    </p>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th></th><th>Part I: CoT</th><th>Part II: ReAct</th></tr>
        </thead>
        <tbody>
          <tr><td>Data</td><td>All of it pasted into the prompt</td><td>Fetched on demand through tools</td></tr>
          <tr><td>Math</td><td>Done by the model, unreliable</td><td><code>calculator</code> tool, exact</td></tr>
          <tr><td>LLM calls</td><td>One</td><td>One per step</td></tr>
          <tr><td>Code needed</td><td>Parse the final output</td><td>Parser, executor, loop, stop conditions</td></tr>
        </tbody>
      </table>
    </div>

    <LessonCallout variant="warn" title="Regex parsing is fragile">
      <p>
        The regexes expect exactly <code>ACT:</code> followed by a newline, then the call. An extra
        space, or the call on the same line, and the parse fails. Production agents usually use the
        API's built-in tool calling: tools are passed as JSON Schema and the model returns
        structured tool calls, not free text. It's the same loop without the hand-written parser.
      </p>
    </LessonCallout>

    <LessonCallout variant="key" title="Remember">
      <p>
        ReAct = a loop of THINK → ACT → OBSERVE. The prompt defines the tools and the format; your
        code parses <code>ACT</code>, runs the real tool, appends <code>OBSERVE</code> to the message
        history, and stops on <code>final_answer</code> or a step limit.
      </p>
    </LessonCallout>


