Finding(**item)
# is exactly the same as:
Finding(claim="Cats sit on mats", quote="The cat sat on the mat.", source_id=0)

# and the list comprehension is shorthand for:
findings = []
for item in json.loads(raw):
    findings.append(Finding(**item))
`.trim();

const retryLoop = String.raw`
def run_step(prompt: str, check, max_attempts: int = 3) -> str:
    """Run one chain step behind a gate check, retrying with the failure reasons."""
    feedback = ""
    for attempt in range(max_attempts):
        output = call_llm(prompt + feedback)
        problems = check(output)
        if not problems:
            return output                                  # gate passed
        feedback = ("\n\nYour previous answer failed these checks:\n- "
                    + "\n- ".join(problems) + "\nFix them.")
    raise RuntimeError(f"Gate check failed after {max_attempts} attempts: {problems}")
`.trim();

