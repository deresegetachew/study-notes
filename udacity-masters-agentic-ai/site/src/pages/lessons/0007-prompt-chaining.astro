const scriptChain = String.raw`
import ast, re

TASK = ("a Python script that reads a CSV, calculates the average of a column, "
        "and writes the results to a new CSV")
ALLOWED_IMPORTS = {"csv", "statistics", "sys"}
MAX_REFINES = 3

def strip_fences(text: str) -> str:
    """Models usually wrap code in a Markdown fence; remove it before parsing."""
    return re.sub(r"^\s*\x60{3}(?:python)?\s*\n|\n?\x60{3}\s*$", "", text.strip())

def check_code(code: str) -> list[str]:
    """Gate 2 (logic): parses as Python, and only imports allowed modules."""
    try:
        tree = ast.parse(code)                    # syntax check — never runs the code
    except SyntaxError as e:
        return [f"SyntaxError line {e.lineno}: {e.msg}"]
    imported = {a.name.split(".")[0] for n in ast.walk(tree) if isinstance(n, ast.Import) for a in n.names}
    imported |= {n.module.split(".")[0] for n in ast.walk(tree) if isinstance(n, ast.ImportFrom) and n.module}
    return [f"Restricted import: {m}" for m in sorted(imported - ALLOWED_IMPORTS)]

# Step 1: outline → Gate 1 (format: a list that mentions reading and writing)
outline = call_llm(f"You are a helpful programming assistant. I need {TASK}. "
                   "Please provide a simple step-by-step outline for this script.")
is_list = any(line.lstrip().startswith(("1.", "-", "*")) for line in outline.splitlines())
if not (is_list and "read" in outline.lower() and "write" in outline.lower()):
    raise RuntimeError("Gate 1 failed: outline is not a step list covering read/write")

# Step 2: code → Gate 2; Step 3: refine with the error feedback, up to MAX_REFINES times
code = strip_fences(call_llm(
    "Based on the following outline, please write the Python code for the script. "
    f"Use standard libraries like 'csv' and 'statistics'.\n\nOutline:\n{outline}"))

for attempt in range(MAX_REFINES + 1):
    errors = check_code(code)
    if not errors:
        break                                     # ✅ Completed
    if attempt == MAX_REFINES:
        raise RuntimeError(f"❌ Failed after {MAX_REFINES} refinements: {errors}")
    code = strip_fences(call_llm(
        f"The following Python code contains errors:\n{code}\n\n"
        f"Error feedback:\n{errors}\n\nPlease correct the code based on this feedback."))
`.trim();

