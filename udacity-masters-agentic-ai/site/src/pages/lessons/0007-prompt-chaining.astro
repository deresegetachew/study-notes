const researchGate = String.raw`
import json
from pydantic import BaseModel, ValidationError

class Finding(BaseModel):
    claim: str
    quote: str        # must be copied word-for-word from a source
    source_id: int

def check_research(raw: str, sources: list[str]) -> list[str]:
    """Gate check: returns a list of problems. Empty list = pass."""
    # Format check: valid JSON, every item has the right fields and types
    try:
        findings = [Finding(**item) for item in json.loads(raw)]
    except (json.JSONDecodeError, TypeError, ValidationError) as e:
        return [f"Format: {e}"]

    # Content check: each quote really appears in the source it cites
    problems = []
    for f in findings:
        if not (0 <= f.source_id < len(sources)) or f.quote not in sources[f.source_id]:
            problems.append(f"Quote not found in source {f.source_id}: {f.quote!r}")
    return problems
`.trim();

const findingExplained = String.raw`
