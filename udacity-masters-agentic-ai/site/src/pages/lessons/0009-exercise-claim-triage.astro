const sampleFnol = `
Claim ID: C003
Customer: Michael Rodriguez
Vehicle: 2022 Ford F-150
Incident: I was involved in a serious collision at an intersection. The front of my truck is
severely damaged, including the hood, bumper, radiator, and engine compartment. The airbags
deployed and the vehicle is not drivable.
`.trim();

const models = String.raw`
class ClaimInformation(BaseModel):                     # Stage I output
    claim_id: str = Field(..., min_length=2, max_length=10)
    name: str = Field(..., min_length=2, max_length=100)
    vehicle: str = Field(..., min_length=2, max_length=100)
    loss_desc: str = Field(..., min_length=10, max_length=500)
    damage_area: List[Literal["windshield", "front", "rear", "side", "roof", "hood",
                              "door", "bumper", "fender", "quarter panel", "trunk",
                              "glass"]] = Field(..., min_items=1)

class SeverityAssessment(BaseModel):                   # Stage II output
    severity: Literal["Minor", "Moderate", "Major"]
    est_cost: float = Field(..., gt=0)

class ClaimRouting(BaseModel):                         # Stage III output
    claim_id: str
    queue: Literal["glass", "fast_track", "material_damage", "total_loss"]
`.trim();

const gate2 = String.raw`
def gate2_cost_range_ok(severity_json: str) -> SeverityAssessment:
    """Gate 2: shape check (Pydantic) + logic check (cost fits the severity)."""
    try:
        validated = SeverityAssessment(**json.loads(severity_json))
        if validated.severity == "Minor" and not 100 <= validated.est_cost <= 1000:
            raise ValueError(f"Minor damage should cost between $100-$1000, got @@{validated.est_cost}")
        # ... same for Moderate ($1,000-$5,000) and Major ($5,000-$50,000)
        return validated
    except Exception as e:
        raise ValueError(f"Gate 2 validation failed: {str(e)}")

def assess_severity(claim_info: ClaimInformation) -> Optional[SeverityAssessment]:
    messages = [{"role": "system", "content": severity_assessment_system_prompt},
                {"role": "user", "content": claim_info.model_dump_json()}]  # stage I output → stage II input
    response = get_completion(messages=messages)
    try:
        return gate2_cost_range_ok(response)
    except ValueError as e:
        print(f"Gate 2 failed: {e}. Response: {response}")
        return None
`.trim().replaceAll('@@{', '$' + '{');


const mindMap = `
# Exercise: Automated Claim Triage
## The chain
### I · Extract → ClaimInformation → Gate 1 (shape)
### II · Assess → SeverityAssessment → Gate 2 (shape + cost range)
### III · Route → ClaimRouting → Gate 3 (allowed queue)
## What the run showed
### Taillight forced into "glass"
### Hail on 3+ panels called Moderate
### Gates check consistency, not truth
## Problems in the code
### Failed stage → None → crash downstream
### Routing rules done by an LLM
### temperature 0.7, no retries, fences break JSON
## Improvements
### Route in code
### Retry with feedback → human review
### Fail closed, never drop a claim
## Scale
### Concurrency, rate limits, cost per claim
### Audit trail, idempotency, drift monitoring
## Principle
### LLM for judgment, code for rules
### Typed contract + gate between every step
`.trim();
