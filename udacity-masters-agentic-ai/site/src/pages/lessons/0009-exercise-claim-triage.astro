    <h2 class="lesson-heading">Checklist <SourceBadge source="course" /></h2>

    <LessonChecklist
      title="Before shipping a triage chain:"
      items={[
        '<strong>One job and one Pydantic model per stage</strong> — the output model is the next stage’s input',
        '<strong>Gate after every stage</strong> — shape always, logic (ranges, rule cross-checks) where possible',
        '<strong>Deterministic rules in code</strong> — don’t pay an LLM to apply an if/else',
        '<strong>Taxonomy covers reality</strong> — add the categories the model keeps forcing into the wrong bucket',
        '<strong>Retries with feedback, capped</strong> — then a human-review queue, never a dropped claim',
        '<strong>No None passed downstream</strong> — failed items leave the main path',
        '<strong>Log everything per claim</strong> — prompts, raw outputs, gate results, model version',
        '<strong>A labeled test set</strong> — including the tricky claims (hail, taillights, keying)',
      ]}
    />

    <h2 class="lesson-heading">Quick-check quiz <SourceBadge source="course" /></h2>

    <LessonQuiz questions={[
      {
