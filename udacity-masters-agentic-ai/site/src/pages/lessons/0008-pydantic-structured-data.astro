const inconsistent = `
"The user is Alex and their order is #8675309."
"Alex's order number is 8675309."
"Order: 8675309, Name: Alex"
`.trim();

const userProfile = String.raw`
from pydantic import BaseModel, Field
from typing import Optional

class UserProfile(BaseModel):
    """A model to hold structured information about a user."""

    # Required (the ... means "no default"), type int, with a description
    user_id: int = Field(..., description="The unique identifier for the user.")

    # Required string
    username: str = Field(..., description="The user's public username.")

    # Required boolean
    is_active: bool = Field(..., description="Whether the user's account is currently active.")

    # Optional: if missing, its value is None
    email: Optional[str] = Field(None, description="The user's email address, if available.")
`.trim();

const parseDemo = String.raw`
profile = UserProfile.model_validate_json(
    '{"user_id": 42, "username": "alex", "is_active": true}'
)
profile.username    # 'alex'   ← dot notation, not profile["username"]
profile.email       # None     ← optional field, not in the JSON
`.trim();

const errorDemo = String.raw`
UserProfile.model_validate_json('{"user_id": "abc", "username": "alex"}')

# pydantic_core.ValidationError: 2 validation errors for UserProfile
# user_id
#   Input should be a valid integer, unable to parse string as an integer
#   [type=int_parsing, input_value='abc', input_type=str]
# is_active
#   Field required [type=missing, ...]
`.trim();

const schemaOut = String.raw`
{
  "title": "UserProfile",
  "description": "A model to hold structured information about a user.",
  "type": "object",
  "properties": {
    "user_id":   { "type": "integer", "description": "The unique identifier for the user." },
    "username":  { "type": "string",  "description": "The user's public username." },
    "is_active": { "type": "boolean", "description": "Whether the user's account is currently active." },
    "email":     { "anyOf": [{ "type": "string" }, { "type": "null" }], "default": null,
                   "description": "The user's email address, if available." }
  },
  "required": ["user_id", "username", "is_active"]
}
`.trim();

const promptAndGate = String.raw`
import json
from pydantic import ValidationError

# 1. In the prompt: the schema tells the LLM exactly what JSON to produce
schema = json.dumps(UserProfile.model_json_schema(), indent=2)
prompt = f"""Extract the user profile from the text below.
Respond with only a JSON object matching this schema:
{schema}

Text:
{text}"""

raw = get_completion(prompt)

# 2. In the gate check: the same model validates the answer
try:
    profile = UserProfile.model_validate_json(raw)
    next_step(profile)                          # ✅ pass a typed object on
except ValidationError as e:
    retry_with_feedback(prompt, str(e))         # ❌ the error text is the feedback
`.trim();

const optionalTrap = String.raw`
class Order(BaseModel):
    customer_email: Optional[str]          # no default → REQUIRED (but may be null)

Order.model_validate({"customer_email": "a@b.com"})   # ✅
Order.model_validate({"customer_email": None})        # ✅ None
Order.model_validate({})                              # ❌ ValidationError: Field required

class Order(BaseModel):
    customer_email: Optional[str] = None   # may be missing OR null → becomes None

Order.model_validate({})                              # ✅ customer_email=None
`.trim();

const laxDemo = String.raw`
class UserProfile(BaseModel):
    user_id: int
    is_active: bool

UserProfile.model_validate_json('{"user_id": "42", "is_active": "yes"}')
# → user_id=42 is_active=True     ✅ no error, no warning
`.trim();

const strictDemo = String.raw`
from pydantic import BaseModel, ConfigDict

class UserProfile(BaseModel):
    model_config = ConfigDict(strict=True)   # no type conversion
    user_id: int
    is_active: bool

# Default (lax) mode accepts "42" → 42 and "yes" → True.
# Strict mode rejects both: "Input should be a valid integer", ...
`.trim();

const exerciseSolution = String.raw`
from typing import List, Optional
from pydantic import BaseModel, Field

class OrderItem(BaseModel):
    sku: str                          # required
    quantity: int                     # required
    item_name: Optional[str] = None   # optional

class Order(BaseModel):
    order_id: int                                         # required
    customer_email: Optional[str] = None                  # optional
    items: List[OrderItem] = Field(..., min_length=1)     # required, at least one item
    total_amount: float                                   # required
`.trim();

const exerciseErrors = String.raw`
Order.model_validate({"order_id": 1001,
                      "items": [{"sku": "MUG-01", "quantity": "two"}],
                      "total_amount": 24.5})
# 1 validation error for Order
# items.0.quantity
#   Input should be a valid integer, unable to parse string as an integer

Order.model_validate({"order_id": 1001, "items": [], "total_amount": 0})
# 1 validation error for Order
# items
#   List should have at least 1 item after validation, not 0
`.trim();

const instructorDemo = String.raw`
import instructor
from pydantic import BaseModel

class User(BaseModel):
    name: str
    age: int

client = instructor.from_provider("openai/gpt-5.4-mini")
user = client.create(
    response_model=User,          # the Pydantic model: sent as the schema, used to validate
    messages=[{"role": "user", "content": "John is 25 years old"}],
