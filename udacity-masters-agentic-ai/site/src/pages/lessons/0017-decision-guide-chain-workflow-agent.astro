const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = (slug: string) => `${base}/lessons/${slug}`;

const chainShape = `
facts = step(EXTRACT_PROMPT,  fnol,  gate_facts)        # model: read the claim
cov   = step(COVERAGE_PROMPT, facts, gate_coverage)     # model: policy table is in the prompt
cost  = step(ASSESS_PROMPT,   facts, gate_assessment)   # model: price table is in the prompt
queue = step(ROUTE_PROMPT,    cov + cost, gate_route)   # model: rules are in the prompt
`.trim();

const workflowShape = `
facts = step(EXTRACT_PROMPT, fnol, gate)           # model: the only call
if not check_coverage(facts.claim_id, facts.incident_type)["covered"]:
    return "needs_review"                          # code decides the branch
total = price_damage(facts.damage_areas)["total"]  # code
queue = route_claim(severity_for(total), total, facts.damage_areas)  # code
`.trim();

const agentShape = `
for turn in range(MAX_STEPS):
    reply = model(history)                         # THINK + ACT: some_tool(...)
    tool, args = parse_action(reply)
    if tool == "final_answer" and final_gate_ok(args):
        return args["queue"]                       # exit 1
    result = TOOLS[tool](**args)                   # the model picked this tool
    history += [reply, "OBSERVE: " + str(result)]
return "needs_review"                              # exit 2: step limit
`.trim();

const testShape = `
# Unit test: plain code, no model, same result every run (workflow; the ReAct agent's tools)
def test_hail_is_total_loss():
    facts = ClaimFacts(claim_id="C004", incident_type="hail",
                       damage_areas=["hood", "roof", "trunk", "mirror", "mirror", "glass"])
    assert decide(facts)["queue"] == "total_loss"

# Gate test: you play the model, no model needed (the ReAct agent's final gate)
def test_gate_refuses_a_guessed_cost():
    facts = {}
    execute('ACT: check_coverage(claim_id="C004", incident_type="hail")', facts)
    execute('ACT: price_damage(areas=["hood", "roof", "trunk", "mirror", "mirror", "glass"])', facts)
    observation, decision = execute('ACT: final_answer(claim_id="C004", queue="material_damage", '
                                    'severity="Moderate", est_cost=3000, reason="hail dents")', facts)
    assert decision is None and "ERROR" in observation

# Evaluation: calls the model, so run a labeled set (several times) and measure
def eval_extraction(labeled_claims, runs=3):
    hits = sum(extract(c.text)[0] == c.expected_facts for c in labeled_claims for _ in range(runs))
    return hits / (len(labeled_claims) * runs)
`.trim();

const mindMap = `
# Decision Guide: Prompt Chain, Workflow or ReAct Agent?
## Three designs
### Prompt chain: fixed steps, all LLM calls
### Workflow: fixed steps, code + LLM, branches
### ReAct agent: the model picks each step
### Course definition (4.1): the LLM plans and decides when to use tools → only ReAct is an agent
## Two questions tell them apart
### What are the steps? chain vs. workflow
### Who decides the next step? workflow vs. ReAct agent
### Loops and gates are in all three
## Two kinds of loop
### Retry: same step again
### ReAct: each turn can go somewhere new
## One claim, three ways
### Same information for all three
### Chain: 4 calls, the model does lookups and sums
### Workflow: 1 call, code does them
### ReAct agent: 4–5 calls, the model asks code to do them
## Cost of running (C004)
### Tokens ≈ 670 : 180 : 2,300
### ReAct agent history grows every turn
### Chain prompts grow with the data
## Cost of change
### Predictable changes → cheapest in a workflow
### New kinds of case → cheapest in a ReAct agent
### Chain: logic in prompt text, hardest to change
## Testability
### Unit tests for code, evaluations for model steps
### Chain: only gates unit-testable
### Workflow: all but extraction unit-testable
### ReAct agent: tools + gate unit-testable, decisions need evals
## When to use what
### Chain: all-language steps, fixed order
### Workflow: known steps with rules and lookups
### ReAct agent: path depends on findings
## The decision
### One prompt enough? → single prompt
### Steps known in advance? no → ReAct agent
### Every step needs language? → chain
### Rules and lookups mixed in → workflow
### One step varies → workflow + ReAct agent step
## Signals
### Volume, latency, audit → workflow
### Many rare cases, path depends on findings → ReAct agent
## Same in every design
### Gates in code, typed contracts, limits, human fallback
## Start simple
### Upgrade when the simpler design hurts
`.trim();
