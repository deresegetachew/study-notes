    direction TB
    w1["🎲 extract"]:::ev --> w1g{{"✅ gate"}}:::ut --> w2["✅ check_coverage"]:::ut --> w3["✅ price_damage"]:::ut --> w4["✅ severity"]:::ut --> w5["✅ route_claim"]:::ut
  end
