---
import LessonLayout      from '@/layouts/LessonLayout.astro';
import LessonHeader      from '@/components/LessonHeader.astro';
import LessonCallout     from '@/components/LessonCallout.astro';
import LessonDiagram     from '@/components/LessonDiagram.astro';
import LessonChecklist   from '@/components/LessonChecklist.astro';
import LessonQuiz        from '@/components/LessonQuiz.astro';
import DeepDive          from '@/components/DeepDive.astro';
import LessonMindMap     from '@/components/LessonMindMap.astro';
import LessonToc         from '@/components/LessonToc.astro';
import SourceBadge       from '@/components/SourceBadge.astro';
import CodeBlock         from '@/components/CodeBlock.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = (slug: string) => `${base}/lessons/${slug}`;

const chainShape = `
info  = step(EXTRACT_PROMPT, fnol, gate1)          # model
sev   = step(ASSESS_PROMPT,  info, gate2)          # model: severity + cost
queue = step(ROUTE_PROMPT,   info + sev, gate3)    # model
`.trim();

const workflowShape = `
facts = step(EXTRACT_PROMPT, fnol, gate)           # model: the only call
if not check_coverage(facts.claim_id, facts.incident_type)["covered"]:
    return "needs_review"                          # code decides the branch
total = price_damage(facts.damage_areas)["total"]  # code
queue = route_claim(severity_for(total), total, facts.damage_areas)  # code
`.trim();

const agentShape = `
for turn in range(MAX_STEPS):
    reply = model(history)                         # THINK + ACT: some_tool(...)
    tool, args = parse_action(reply)
    if tool == "final_answer" and final_gate_ok(args):
        return args["queue"]                       # exit 1
    result = TOOLS[tool](**args)                   # the model picked this tool
    history += [reply, "OBSERVE: " + str(result)]
return "needs_review"                              # exit 2: step limit
`.trim();

const mindMap = `
# Decision Guide: Prompt Chain, Workflow or Agent?
## Three designs
### Prompt chain: fixed steps, all LLM calls
### Workflow: fixed steps, code + LLM, branches
### Agent: the model picks each step
## Two questions tell them apart
### What are the steps? chain vs. workflow
### Who decides the next step? workflow vs. agent
### Loops and gates are in all three
## Two kinds of loop
### Retry: same step again
### ReAct: each turn can go somewhere new
## One claim, three ways
### Chain: 3 calls, guessed cost, wrong
### Workflow: 1 call, right, same path
### Agent: 4–5 calls, right, path varies
## The decision
### One prompt enough? → single prompt
### Steps known in advance? no → agent
### Every step needs language? → chain
### Rules and lookups mixed in → workflow
### One step varies → workflow + agent step
## Signals
### Volume, latency, audit → workflow
### Many rare cases, path depends on findings → agent
## Same in every design
### Gates in code, typed contracts, limits, human fallback
## Start simple
### Upgrade when the simpler design hurts
`.trim();
---

<LessonLayout title="4.7 — Decision Guide: Prompt Chain, Workflow or Agent?">

  <LessonHeader
    num="4.7"
    title="Decision Guide: Prompt Chain, Workflow or Agent?"
    subtitle="The same insurance claims built three ways, compared side by side, and a guide for choosing the design."
  />

  <div class="lesson-content">

    <LessonToc />

    <h2 class="lesson-heading">One Job, Three Designs <SourceBadge source="mine" /></h2>

    <p>Lessons 4.4 to 4.6 triaged the same car-insurance claims three ways:</p>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Lesson</th><th>Design</th><th>In one line</th></tr>
        </thead>
        <tbody>
          <tr><td><a href={L('0009-exercise-claim-triage')}>4.4</a></td><td><strong>Prompt chain</strong></td><td>Fixed steps, every step an LLM call: extract → assess → route</td></tr>
          <tr><td><a href={L('0016-exercise-claims-workflow')}>4.6</a></td><td><strong>Workflow</strong></td><td>Fixed steps, one LLM call to read the claim, the rest in code</td></tr>
          <tr><td><a href={L('0013-exercise-claim-agent')}>4.5</a></td><td><strong>ReAct agent</strong></td><td>The model picks the next tool each turn; errors go back to it</td></tr>
        </tbody>
      </table>
    </div>

    <p>
      The rest of this page puts them next to each other: how each one runs, what actually tells them apart, the
      same claim through all three, and the shape of the code. The columns are always in the same order: chain,
      workflow, agent, from most fixed to most flexible.
    </p>

    <h2 class="lesson-heading">How Each One Runs <SourceBadge source="mine" /></h2>

    <LessonDiagram definition={`
flowchart LR
  subgraph CH["🔗 Prompt chain"]
    direction TB
    c0["📄 claim"]:::in --> c1["🤖 extract"]:::llm --> c1g{{"🚦"}}:::gate --> c2["🤖 assess<br/>severity + cost"]:::llm --> c2g{{"🚦"}}:::gate --> c3["🤖 route"]:::llm --> c3g{{"🚦"}}:::gate --> c4["📥 queue"]:::done
    c1g -.->|"retry"| c1
    c2g -.->|"retry"| c2
  end
  subgraph WF["⚙️ Workflow"]
    direction TB
    w0["📄 claim"]:::in --> w1["🤖 extract"]:::llm --> w1g{{"🚦"}}:::gate --> w2["🛠️ check_coverage"]:::code --> w3["🛠️ price_damage"]:::code --> w4["🧮 severity"]:::code --> w5["🛠️ route_claim"]:::code --> w6["📥 queue"]:::done
    w1g -.->|"retry"| w1
    w2 -.->|"not covered"| w7["👤 review"]:::warn
  end
  subgraph AG["🤖 ReAct agent"]
    direction TB
    a0["📄 claim"]:::in --> a1["🤖 THINK + ACT<br/>picks a tool"]:::llm --> a2["🛠️ the tool it picked"]:::code
    a2 -.->|"OBSERVE"| a1
    a1 -->|"final_answer"| a3{{"🚦 final gate"}}:::gate --> a4["📥 queue"]:::done
    a3 -.->|"ERROR"| a1
  end
  CH ~~~ WF ~~~ AG

  classDef in   fill:#f1f5f9,color:#0f172a,stroke:#64748b,stroke-width:2px
  classDef llm  fill:#dbeafe,color:#1e3a8a,stroke:#2563eb,stroke-width:2px
  classDef code fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px
  classDef gate fill:#ede9fe,color:#4c1d95,stroke:#7c3aed,stroke-width:2px
  classDef done fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px
  classDef warn fill:#fee2e2,color:#7f1d1d,stroke:#dc2626,stroke-width:2px
    `} />

    <p>
      Blue boxes are model calls, yellow boxes are code. Read the lanes left to right: the chain is all blue; the
      workflow is one blue box and then yellow; the agent is a single blue box in a loop, and which yellow box it
      reaches is up to the model. Use the ⤢ button to enlarge the diagram.
    </p>

    <h2 class="lesson-heading">What Tells Them Apart <SourceBadge source="mine" /></h2>

    <p>
      All three have gates, and all three can loop. So those aren't the difference. Two questions are:
    </p>

    <ol>
      <li><strong>What are the steps?</strong> Separates the chain from the workflow.</li>
      <li><strong>Who decides the next step?</strong> Separates the workflow from the agent.</li>
    </ol>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th></th><th>Prompt chain</th><th>Workflow</th><th>ReAct agent</th></tr>
        </thead>
        <tbody>
          <tr><td><strong>Who decides the next step?</strong></td><td>Code</td><td>Code</td><td><strong>The model</strong></td></tr>
          <tr><td><strong>What are the steps?</strong></td><td>All model calls</td><td>Model calls <strong>and</strong> code/functions</td><td>Whatever tool the model asks for</td></tr>
          <tr><td>Functions (coverage, prices…)</td><td>None</td><td>Called by your code</td><td><strong>Called because the model asked</strong> (tool calls)</td></tr>
          <tr><td>What the loop does</td><td>Retries the same step</td><td>Retries the same step</td><td><strong>Is</strong> the design: each turn can do something different</td></tr>
          <tr><td>Gates</td><td>After each step</td><td>After the model step</td><td>Final gate before the answer is accepted</td></tr>
        </tbody>
      </table>
    </div>

    <h3 class="lesson-heading">Two kinds of loop</h3>

    <p>
      The word "loop" covers two different things here. In the chain and the workflow, a loop is a <strong>retry</strong>:
      a step's output fails its gate, the error goes back to the model, and the <em>same</em> step runs again, at most
      three times. The next step is still fixed. In the agent, the loop is the <strong>engine</strong>: think, call a
      tool, observe, decide again, and each turn can go somewhere different. Both are feedback loops (generate, check,
      feed the result back); only the agent's decides where to go next.
    </p>

    <h3 class="lesson-heading">Tool calls are what make it ReAct</h3>

    <p>
      The workflow and the agent use the same functions. In the workflow your code calls
      <code>price_damage(...)</code> at a fixed point. In the agent the model writes <code>ACT: price_damage(...)</code>,
      your code runs it, and the model reads the result before choosing what to do next. A function the model can ask
      for is a <strong>tool</strong>; the model asking is a <strong>tool call</strong>.
    </p>

    <h2 class="lesson-heading">Step by Step, Side by Side <SourceBadge source="mine" /></h2>

    <p>Claim C004: hail dents on the hood, roof and trunk, damaged side mirrors, a cracked window.</p>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Stage</th><th>Prompt chain (course's 4.4)</th><th>Workflow (4.6)</th><th>ReAct agent (4.5)</th></tr>
        </thead>
        <tbody>
          <tr><td>Read the claim</td><td>🤖 Extract: name, vehicle, description, areas</td><td>🤖 Extract: incident type (hail), areas counted (two mirrors)</td><td>🤖 Reads it in its first THINK</td></tr>
          <tr><td>Coverage</td><td>Not checked</td><td>🛠️ Code calls <code>check_coverage</code>: covered</td><td>🤖 → 🛠️ Asks for <code>check_coverage(hail)</code>: covered</td></tr>
          <tr><td>Cost</td><td>🤖 <strong>Guesses</strong> $3,000</td><td>🛠️ Code calls <code>price_damage</code>: $5,450</td><td>🤖 → 🛠️ Asks for <code>price_damage</code>: $5,450</td></tr>
          <tr><td>Severity</td><td>🤖 Judges Moderate</td><td>🧮 Code: $5,450 is Major</td><td>🤖 Picks Major (the gate checks it fits $5,450)</td></tr>
          <tr><td>Route</td><td>🤖 → <code>material_damage</code></td><td>🛠️ Code → <code>total_loss</code></td><td>🤖 → 🛠️ Asks for <code>route_claim</code> → <code>total_loss</code></td></tr>
          <tr><td>Who chose these steps</td><td>Your code, before any claim arrived</td><td>Your code, before any claim arrived</td><td>The model, while handling this claim</td></tr>
          <tr><td>If a step fails</td><td>Retry that step, then human review</td><td>Retry extraction, then human review</td><td>Error goes back as OBSERVE; step limit, then human review</td></tr>
          <tr><td>Model calls</td><td>3</td><td>1</td><td>4–5</td></tr>
          <tr><td>Result</td><td>❌ Moderate, $3,000</td><td>✅ Major, $5,450</td><td>✅ Major, $5,450</td></tr>
        </tbody>
      </table>
    </div>

    <p>
      Two lessons in that table. First, the chain got it wrong because the model <em>guessed</em> a number, not
      because it was a chain. Second, the workflow and the agent got it right for the same reason, the price table,
      and the workflow did it with a quarter of the model calls. Tools and gates decided correctness here; the design
      decided cost and predictability.
    </p>

    <LessonCallout variant="info" title="The original 4.4 vs. the improved one">
      <p>
        The chain column is the course's original run: three model calls, routing included. The improved version in
        the 4.4 notebook moves routing into code and adds retries with feedback, so it sits between a chain and a
        workflow. Each step along the scale hands more of the job to code.
      </p>
    </LessonCallout>

    <h2 class="lesson-heading">The Shape of the Code <SourceBadge source="mine" /></h2>

    <p>
      Simplified from the notebooks, so the three are easy to compare. <code>step(prompt, text, gate)</code> is a model call
      with its gate and retries.
    </p>

    <CodeBlock lang="python" label="prompt chain: every step is a model call" code={chainShape} />
    <CodeBlock lang="python" label="workflow: one model call, then code" code={workflowShape} />
    <CodeBlock lang="python" label="ReAct agent: the model picks each step" code={agentShape} />

    <p>
      Compare the first two: same top-to-bottom shape, but the workflow's model calls have become function calls. Then
      compare the last two: the same functions, but in the agent they're never called in the code you wrote; they're
      looked up by name from whatever the model asked for.
    </p>

    <h2 class="lesson-heading">Trade-offs <SourceBadge source="mine" /></h2>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th></th><th>Prompt chain</th><th>Workflow</th><th>Agent</th></tr>
        </thead>
        <tbody>
          <tr><td>Who picks the next step</td><td>Code</td><td>Code</td><td>The model</td></tr>
          <tr><td>Where the LLM is used</td><td>Every step</td><td>Only where text needs reading or writing</td><td>Every turn, to choose and to read</td></tr>
          <tr><td>Same input, same path?</td><td>Yes</td><td>Yes</td><td>Not always</td></tr>
          <tr><td>Cost and latency</td><td>Medium: one call per step</td><td>Lowest</td><td>Highest, and it varies</td></tr>
          <tr><td>Testing</td><td>Test each step</td><td>Unit-test the code; test the LLM steps</td><td>Test tools and gates; evaluate whole traces</td></tr>
          <tr><td>Debugging</td><td>Find the failing step</td><td>Find the failing step</td><td>Read the THINK/ACT/OBSERVE trace</td></tr>
          <tr><td>A new kind of case</td><td>New step or prompt change</td><td>New branch in code</td><td>Often a new tool or a line in a description</td></tr>
          <tr><td>Best when</td><td>Every step needs language, in a known order</td><td>Steps are known; some are rules or lookups</td><td>The path depends on what you find</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="lesson-heading">The Terms <SourceBadge source="mine" /></h2>

    <ul>
      <li>
        A <strong>prompt chain</strong> is a workflow whose steps are all LLM calls, each one's output feeding the next
        (lesson 4.2).
      </li>
      <li>
        A <strong>workflow</strong> is a fixed set of steps that your code runs, with branches. Some steps call an LLM,
        some call tools or plain functions. Lesson 4.2's "hard-coded workflow" (the dental appointment) is one.
      </li>
      <li>
        An <strong>agent</strong> is an LLM in a loop with tools, choosing its own next step until it decides it's done
        or hits a limit (lessons 2.1 and 4.5).
      </li>
    </ul>

    <p>They sit on a scale, from most predictable to most flexible:</p>

    <LessonDiagram definition={`
flowchart LR
  A["📝 Single prompt"]:::p --> B["🔗 Prompt chain"]:::p --> C["⚙️ Workflow<br/>code + LLM steps"]:::w --> D["⚙️🤖 Workflow with<br/>one agent step"]:::w --> E["🤖 Agent"]:::a
  classDef p fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px
  classDef w fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px
  classDef a fill:#dbeafe,color:#1e3a8a,stroke:#2563eb,stroke-width:2px
    `} />

    <p>
      Moving right buys flexibility and costs predictability, money and latency. The guide below is about moving
      only as far right as the problem needs.
    </p>

    <h2 class="lesson-heading">The Decision Guide <SourceBadge source="mine" /></h2>

    <LessonDiagram definition={`
flowchart TB
  S["🧩 A task"]:::in --> Q1{{"Can one well-written prompt<br/>do it reliably?"}}:::q
  Q1 -->|"yes"| R1["📝 Single prompt<br/>+ a gate on the output"]:::p
  Q1 -->|"no"| Q2{{"Can you write the steps<br/>down in advance?"}}:::q
  Q2 -->|"no: the next step depends<br/>on what you find"| R4["🤖 Agent<br/>tools · gates in code · step limit"]:::a
  Q2 -->|"yes"| Q3{{"Does every step need<br/>language understanding?"}}:::q
  Q3 -->|"yes"| R2["🔗 Prompt chain<br/>gate between steps"]:::p
  Q3 -->|"no: some are rules,<br/>lookups or maths"| R3["⚙️ Workflow<br/>code for those steps"]:::w
  R3 --> Q4{{"Is there one step whose<br/>path varies a lot?"}}:::q
  Q4 -->|"yes"| R5["⚙️🤖 Workflow with an agent step"]:::w
  Q4 -->|"no"| R6["✅ Keep the workflow"]:::w

  classDef in fill:#f1f5f9,color:#0f172a,stroke:#64748b,stroke-width:2px
  classDef q  fill:#ede9fe,color:#4c1d95,stroke:#7c3aed,stroke-width:2px
  classDef p  fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px
  classDef w  fill:#fef3c7,color:#78350f,stroke:#d97706,stroke-width:2px
  classDef a  fill:#dbeafe,color:#1e3a8a,stroke:#2563eb,stroke-width:2px
    `} />

    <h3 class="lesson-heading">Signals that push one way or the other</h3>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Signal</th><th>Leans toward</th></tr>
        </thead>
        <tbody>
          <tr><td>Steps are known and rarely change</td><td>Workflow (or chain)</td></tr>
          <tr><td>Steps include rules, numbers or lookups</td><td>Workflow: those steps are code</td></tr>
          <tr><td>The next step depends on what the last one found</td><td>Agent</td></tr>
          <tr><td>Many rare cases, and new ones keep appearing</td><td>Agent, or a workflow with an agent step</td></tr>
          <tr><td>High volume, cost per item matters</td><td>Workflow</td></tr>
          <tr><td>Users are waiting (latency)</td><td>Workflow: fewer calls</td></tr>
          <tr><td>Audits or regulation: same input, same path</td><td>Workflow</td></tr>
          <tr><td>The input is open-ended text, a conversation, or research</td><td>Agent</td></tr>
          <tr><td>The action moves money or can't be undone</td><td>Any design, but the decision is checked by a gate in code</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="lesson-heading">Applied to the Course's Exercises <SourceBadge source="mine" /></h2>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Exercise</th><th>Best fit</th><th>Why</th></tr>
        </thead>
        <tbody>
          <tr><td>4.4–4.6 Insurance claims</td><td>Workflow</td><td>Same steps for every claim; costs and rules are code</td></tr>
          <tr><td><a href={L('0015-exercise-invoice-claim-agent')}>4.8</a> Invoice claims</td><td>Both, per channel</td><td>Claim-button claims are structured (workflow); emails are vague and varied (agent)</td></tr>
          <tr><td><a href={L('0014-exercise-invoice-agent')}>4.9</a> Supplier invoices</td><td>Workflow now; agent as exceptions grow</td><td>Seven paths fit in a few branches; many more would not</td></tr>
          <tr><td>2.1 Demand-spike detective</td><td>Agent</td><td>Which data to look at next depends on what the last lookup showed</td></tr>
          <tr><td>5.1–5.2 Feedback loops</td><td>A loop inside either design</td><td>Generate → test → feed back is a pattern a workflow or an agent can contain</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="lesson-heading">What Stays the Same in Every Design <SourceBadge source="mine" /></h2>

    <p>
      Choosing the design is about who picks the next step. The safety comes from the same places whichever you
      choose:
    </p>

    <ul>
      <li><strong>Gates in code</strong> on anything an LLM produces (Pydantic for shape, rules for logic).</li>
      <li><strong>Typed contracts</strong> between steps.</li>
      <li><strong>Rules, numbers and lookups in code</strong>, never guessed by the model.</li>
      <li><strong>Limits</strong>: retries in a workflow, steps in an agent.</li>
      <li><strong>A human fallback</strong>, so nothing is dropped or forced through.</li>
    </ul>

    <LessonCallout variant="key" title="Start simple, move right when it hurts">
      <p>
        Begin with the simplest design that could work, and move along the scale only when it stops working: a
        workflow whose branches keep multiplying, or traces showing an agent that takes the same path every time
        (it's a workflow in disguise, at a higher price). Anthropic's article
        <a href="https://www.anthropic.com/engineering/building-effective-agents" target="_blank" rel="noopener">Building effective agents</a>
        makes the same case, and describes prompt chaining and other workflow patterns in more detail.
      </p>
    </LessonCallout>

    <h2 class="lesson-heading">Checklist <SourceBadge source="mine" /></h2>

    <LessonChecklist
      title="Before choosing a design:"
      items={[
        '<strong>Try one prompt first</strong>, with a gate on the output',
        '<strong>Write the steps down</strong>: if you can, start with a chain or a workflow',
        '<strong>Mark each step</strong> as language (LLM) or rules/lookups/maths (code)',
        '<strong>Look for the step whose path varies</strong>; only that part might need an agent',
        '<strong>Weigh volume, latency and audit needs</strong>; they all favour workflows',
        '<strong>Put the gates in code</strong> whichever design you pick',
        '<strong>Compare on the same inputs</strong>: results, LLM calls, and whether the path is stable',
        '<strong>Revisit the choice</strong> when branches multiply or traces show a fixed path',
      ]}
    />

