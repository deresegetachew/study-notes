const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = (slug: string) => `${base}/lessons/${slug}`;

const chainShape = `
facts = step(EXTRACT_PROMPT,  fnol,  gate_facts)        # model: read the claim
cov   = step(COVERAGE_PROMPT, facts, gate_coverage)     # model: policy table is in the prompt
cost  = step(ASSESS_PROMPT,   facts, gate_assessment)   # model: price table is in the prompt
queue = step(ROUTE_PROMPT,    cov + cost, gate_route)   # model: rules are in the prompt
`.trim();

const workflowShape = `
facts = step(EXTRACT_PROMPT, fnol, gate)           # model: the only call
if not check_coverage(facts.claim_id, facts.incident_type)["covered"]:
    return "needs_review"                          # code decides the branch
total = price_damage(facts.damage_areas)["total"]  # code
queue = route_claim(severity_for(total), total, facts.damage_areas)  # code
`.trim();

const agentShape = `
for turn in range(MAX_STEPS):
    reply = model(history)                         # THINK + ACT: some_tool(...)
    tool, args = parse_action(reply)
    if tool == "final_answer" and final_gate_ok(args):
        return args["queue"]                       # exit 1
    result = TOOLS[tool](**args)                   # the model picked this tool
    history += [reply, "OBSERVE: " + str(result)]
return "needs_review"                              # exit 2: step limit
`.trim();

const mindMap = `
# Decision Guide: Prompt Chain, Workflow or Agent?
## Three designs
### Prompt chain: fixed steps, all LLM calls
### Workflow: fixed steps, code + LLM, branches
### Agent: the model picks each step
## Two questions tell them apart
### What are the steps? chain vs. workflow
### Who decides the next step? workflow vs. agent
### Loops and gates are in all three
## Two kinds of loop
### Retry: same step again
### ReAct: each turn can go somewhere new
## One claim, three ways
### Same information for all three
### Chain: 4 calls, the model does lookups and sums
### Workflow: 1 call, code does them
### Agent: 4–5 calls, the model asks code to do them
## The decision
### One prompt enough? → single prompt
### Steps known in advance? no → agent
### Every step needs language? → chain
### Rules and lookups mixed in → workflow
### One step varies → workflow + agent step
## Signals
### Volume, latency, audit → workflow
### Many rare cases, path depends on findings → agent
## Same in every design
### Gates in code, typed contracts, limits, human fallback
## Start simple
### Upgrade when the simpler design hurts
`.trim();
