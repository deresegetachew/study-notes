---
import LessonLayout  from '@/layouts/LessonLayout.astro';
import LessonHeader  from '@/components/LessonHeader.astro';
import LessonCallout from '@/components/LessonCallout.astro';
import CodeBlock     from '@/components/CodeBlock.astro';
import LessonDiagram from '@/components/LessonDiagram.astro';
import SourceBadge   from '@/components/SourceBadge.astro';
import LessonChecklist from '@/components/LessonChecklist.astro';
import LessonQuiz      from '@/components/LessonQuiz.astro';
import DeepDive        from '@/components/DeepDive.astro';
import LessonMindMap   from '@/components/LessonMindMap.astro';

const piratePrompt = `
Act as a pirate.                          ← Role
Respond only to questions about your ship. ← Task
Output sentences in Markdown.             ← Output Format
Example, Q: What is 1 + 1 / A: Me knows not!   ← Example
Your ship's name: Neptune's Fury.         ← Context
`.trim();

const vaguePrompt = `
customer_email = """
Hi, I'm writing because I was charged twice for my last order (Order #8675309).
I thought my subscription was paused. Can you please look into this and reverse the extra charge?
Thanks,
Alex
"""

system_prompt_vague = "You are a helpful assistant."
user_prompt_vague = f"Please categorize the following email:\\n\\n{customer_email}"
`.trim();

const vagueOutput = `
This email appears to be a billing issue related to a double charge on an order.
`.trim();

const refinedPrompt = `
system_prompt_refined = """
You are an expert customer support agent responsible for categorizing          # Role
incoming emails for a ticketing system.

Your task is to analyze the user's email and provide a structured JSON output.  # Task

## Email Categories:                                                            # Context
- **Billing:** For issues related to charges, subscriptions, or refunds.
- **Technical Support:** For problems with product functionality or bugs.
- **General Inquiry:** For questions that do not fit the other categories.

## Output Format:                                                               # Output Format
You must respond with a single JSON object containing the following keys:
- \`category\`: (string) One of "Billing", "Technical Support", or "General Inquiry".
- \`summary\`: (string) A one-sentence summary of the user's issue.
- \`urgency\`: (string) "High", "Medium", or "Low".
- \`customer_id\`: (string) Extract the order number or customer ID if available, otherwise "N/A".
"""

user_prompt_refined = f"Please analyze and categorize this email:\\n\\n{customer_email}"
`.trim();

const refinedOutput = `
{
  "category": "Billing",
  "summary": "The customer was charged twice for order #8675309 and is requesting a refund for the extra charge.",
  "urgency": "High",
  "customer_id": "8675309"
}
`.trim();

const ticketBefore = `
Summarize this customer email.

{email}
`.trim();

const ticketAfter = `
You are a support team lead writing handoff notes for the on-call engineer.     ← Role

Read the customer email below and summarize the problem so the engineer can     ← Task
act without reading the original.

Steps:                                                                           ← Break it down
1. Identify the product and feature involved.
2. List what the customer already tried.
3. Copy any error messages exactly.
4. Judge urgency.

Return JSON with these keys:                                                     ← Output format
  product, problem (max 2 sentences), steps_tried (list),
  error_messages (list), urgency ("low" | "medium" | "high")
If something isn't in the email, use null. Don't invent details.                ← Constraints

Example                                                                          ← Few-shot
Email: "Export to CSV fails with 'Error 413' since this morning. Tried Chrome and Safari."
Output: {"product": "Reports", "problem": "CSV export fails with Error 413.",
         "steps_tried": ["Chrome", "Safari"], "error_messages": ["Error 413"],
         "urgency": "medium"}

Context: our products are Reports, Billing, and Sync.                            ← Context
"high" urgency = an outage or data loss.

Email:
{email}
`.trim();

const toolBeforeAfter = `
# Weak
get_orders(id) — gets orders

# Refined
get_orders(customer_id: str)
  Returns the 20 most recent orders for ONE customer, newest first, as a list of
  {order_id, date, status, total}.
  Use when the user asks about order status or order history.
  Do NOT use for refunds — use create_refund instead.
  customer_id looks like "C-12345".
`.trim();

const nolaTask = `
Recommend a unique local dish in New Orleans for first-time visitors seeking unique
fusion flavors. Under 75 words. Focus on taste. Don't name specific restaurants.
A single paragraph with a hook.
`.trim();

const nolaJsonOutput = `
{
  "dish_title": "NOLA's Secret Soup: Yakamein!",
  "description": "Forget gumbo for a sec and try Yakamein! This soulful noodle soup boasts a rich, spicy beef broth swimming with noodles and savory surprises. It's a unique Creole-Asian flavor adventure you won't forget! Comfort food with a NOLA twist."
}
`.trim();

const mindMap = `
# Prompt Instruction Refinement
## Goal
### Evaluate + adjust instructions
### More precise output
## Components to adjust
### Role
### Task — clear, detailed goals
### Output Format
### Examples — 1-shot / many-shot
### Context
## Pirate-ship example
### Off-topic → “Me knows not!”
### Name in context → used
### Age not in context → vague, not invented
### Want the age used → add to context
## Refinement loop
### Write → run → evaluate
### Find the component at fault
### Adjust one, run again
## Modifying each component
### Role → persona, tone, style
### Task → action + constraints
### Output Format → structure
### Examples → patterns, but not enough alone
### Context → information + scope
### Components interact
## Best practices
### Clear, detailed instructions
### Roles, decomposition, CoT
### Format + constraints, few-shot
### Relevant context, clear tool descriptions
## Pitfalls
### Ambiguity, too little / too much context
### Poor tool descriptions
### Hallucination, bias, adversarial prompts
## Worked examples
### Vague → structured email triage (course)
### Correct ≠ useful: needs parseable JSON
### Every best practice: steps, few-shot, null rule
### Tool description: returns, when, when not
## EverGreen example
### Task only → too brief
### + Context → benefits
### + Role + Constraints → engaging
`.trim();
---

<LessonLayout title="3.1 — Prompt Instruction Refinement">

  <LessonHeader
    num="3.1"
    title="Prompt Instruction Refinement"
    subtitle="Evaluating and adjusting prompt instructions to get more precise LLM outputs."
  />

  <div class="lesson-content">

    <h2 class="lesson-heading">What Refinement Is <SourceBadge source="course" /></h2>

    <p>
      Prompt instruction refinement means evaluating your prompt's instructions and adjusting them
      to get more precise output. LLMs are good at understanding and generating language, but their
      output isn't always what you expected. Tailoring the prompt is part art, part science, and
      better prompts lead to better results.
    </p>

    <p>This part of the course covers:</p>

    <ul>
      <li>Analyzing the components of a prompt</li>
      <li>Strategies for systematically adjusting instructions for more targeted results</li>
      <li>How to evaluate the differences between prompt versions</li>
      <li>Best practices for adjusting prompts</li>
      <li>Common pitfalls to avoid</li>
      <li>Comparing multiple prompt versions on coding tasks</li>
    </ul>

    <h2 class="lesson-heading">Prompt Components Revisited <SourceBadge source="course" /></h2>

    <p>
      Refinement starts from the five components from lesson 1.3: <strong>Role</strong>,
      <strong>Task</strong>, <strong>Output Format</strong>, <strong>Examples</strong> (one-shot or
      many-shot), and <strong>Context</strong>. For complex tasks, the Task should spell out clear,
      detailed goals. Each component is a separate thing you can adjust.
    </p>

    <LessonDiagram definition={`
flowchart LR
  subgraph P["Effective prompt"]
    direction TB
    R["🎭 Role<br/>persona"]:::role
    T["🎯 Task<br/>core intent, clear goals"]:::task
    O["📐 Output Format<br/>JSON, CSV, Markdown…"]:::format
    E["🧪 Examples<br/>1-shot or many-shot"]:::examples
    C["📚 Context<br/>background facts"]:::context
    R --> T --> O --> E --> C
  end
  P --> L["🤖 LLM"]:::llm --> Out["📝 Output"]:::done

  classDef role     fill:#ede9fe,color:#4c1d95,stroke:#7c3aed,stroke-width:2px
  classDef task     fill:#dbeafe,color:#1e3a8a,stroke:#2563eb,stroke-width:2px
  classDef format   fill:#fef9c3,color:#713f12,stroke:#ca8a04,stroke-width:2px
  classDef examples fill:#ffedd5,color:#7c2d12,stroke:#ea580c,stroke-width:2px
  classDef context  fill:#ccfbf1,color:#134e4a,stroke:#0d9488,stroke-width:2px
  classDef llm      fill:#f1f5f9,color:#0f172a,stroke:#64748b,stroke-width:2px
  classDef done     fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px
    `} />

    <h3 class="lesson-heading">Example: the pirate-ship agent</h3>

    <p>An agent that should only answer questions about its ship:</p>

    <CodeBlock lang="text" label="pirate-prompt" code={piratePrompt} />

    <LessonDiagram definition={`
flowchart LR
  R["🎭 Role<br/>Act as a pirate"]:::role
  T["🎯 Task<br/>Respond only to questions<br/>about your ship"]:::task
  O["📐 Output Format<br/>Sentences in Markdown"]:::format
  E["🧪 Example<br/>Q: What is 1 + 1<br/>A: Me knows not!"]:::examples
  C["📚 Context<br/>Ship name: Neptune’s Fury"]:::context
  R --> T --> O --> E --> C

  classDef role     fill:#ede9fe,color:#4c1d95,stroke:#7c3aed,stroke-width:2px
  classDef task     fill:#dbeafe,color:#1e3a8a,stroke:#2563eb,stroke-width:2px
  classDef format   fill:#fef9c3,color:#713f12,stroke:#ca8a04,stroke-width:2px
  classDef examples fill:#ffedd5,color:#7c2d12,stroke:#ea580c,stroke-width:2px
  classDef context  fill:#ccfbf1,color:#134e4a,stroke:#0d9488,stroke-width:2px
    `} />

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>User asks</th><th>Agent replies</th><th>Why</th></tr>
        </thead>
        <tbody>
          <tr><td>What's the date?</td><td>"Me knows not!"</td><td>Off-topic. It follows the example's refusal pattern.</td></tr>
          <tr><td>What's the ship's name?</td><td>"She be called the Neptune's Fury, a right terror o' the waves!"</td><td>The name is in the context.</td></tr>
          <tr><td>How old is the ship?</td><td>"Arr, she be old enough t' have seen horrors ye wouldn't believe…"</td><td>The age isn't in the context, so it stays vague instead of inventing a number.</td></tr>
        </tbody>
      </table>
    </div>

    <p>
      That might be exactly the behavior you want. But if you know the ship's age and want the agent
      to use it, the prompt has to change: add the age to the Context. The model can only work with
      facts it's given. Here it correctly avoided inventing one, but it also can't supply what isn't
      there.
    </p>

    <h3 class="lesson-heading">The refinement loop</h3>

    <LessonDiagram definition={`
flowchart LR
  W["✍️ Write prompt"]:::step --> Run["▶️ Run it"]:::step --> Ev{"Output what<br/>you wanted?"}:::decision
  Ev -->|yes| Done["✅ Keep this version"]:::done
  Ev -->|no| Id["🔍 Find the component<br/>at fault"]:::warn --> Adj["🔧 Adjust that one<br/>component"]:::step --> Run

  classDef step     fill:#dbeafe,color:#1e3a8a,stroke:#2563eb,stroke-width:2px
  classDef decision fill:#ede9fe,color:#4c1d95,stroke:#7c3aed,stroke-width:2px
  classDef done     fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px
  classDef warn     fill:#fee2e2,color:#7f1d1d,stroke:#dc2626,stroke-width:2px
    `} />

    <p>
      In the pirate example: the age question gives a vague answer → the fault is Context (the age
      is missing) → add the age → run again.
    </p>

    <h2 class="lesson-heading">Systematically Adjusting Prompt Components <SourceBadge source="course" /></h2>

    <p>Modifying each component affects the output in a different way:</p>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Component</th><th>Changing it alters…</th><th>Example</th></tr>
        </thead>
        <tbody>
          <tr><td>Role</td><td>Persona, tone, style, perspective</td><td>"helpful assistant" vs. "skeptical historian"</td></tr>
          <tr><td>Task</td><td>The core action and its constraints</td><td>"summarize this text" vs. "translate this text" vs. "write a poem under 50 words"</td></tr>
          <tr><td>Output Format</td><td>The response's structure</td><td>bullet points vs. paragraph; JSON vs. plain text</td></tr>
          <tr><td>Examples</td><td>Style, structure, detail, and quality, by showing desired patterns</td><td>an example written in the target style</td></tr>
          <tr><td>Context</td><td>The background information and scope used</td><td>a different article to summarize</td></tr>
        </tbody>
      </table>
    </div>

    <p>
      It's like tuning an instrument: small adjustments can drastically change the sound. Minor
      wording changes or a different persona can significantly change the response, because the
      model relies entirely on the explicit instructions you give it. Making one or a few targeted
      changes at a time shows you how each part of the prompt influences the output.
    </p>

    <h2 class="lesson-heading">Example: Modifying Each Component <SourceBadge source="course" /></h2>

    <p>The base task:</p>

    <CodeBlock lang="text" label="new-orleans-task" code={nolaTask} />

    <h3 class="lesson-heading">1. Modify the Role</h3>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Role</th><th>Output (start)</th><th>Effect</th></tr>
        </thead>
        <tbody>
          <tr><td>Cheerful food blogger</td><td>"Ready for a taste adventure found only in New Orleans? You have to try Yakamein! Picture this: a wonderfully savory, beefy noodle soup…"</td><td>Correct, matches the upbeat style</td></tr>
          <tr><td>High-Dining Food Critic and Connoisseur</td><td>"Ready to taste New Orleans beyond gumbo? Seek out Yakamein, the city's soulful answer to noodle soup. Often called "Old Sober," this unique fusion…"</td><td>Same content, more sophisticated style</td></tr>
        </tbody>
      </table>
    </div>

    <h3 class="lesson-heading">2. Modify the Task (constraint)</h3>

    <p>
      Tighten the length limit to <strong>15 words or less</strong> (still the cheerful food blogger):
      <em>"Spice lover? Taste explosive Viet-Cajun crawfish – garlicky, buttery, fiery fusion magic
      awaits!"</em>
    </p>

    <h3 class="lesson-heading">3. Modify the Output Format</h3>

    <p>
      Ask for JSON with separate <code>dish_title</code> and <code>description</code> fields. Useful
      when code needs to parse the result:
    </p>

    <CodeBlock lang="json" label="json-output" code={nolaJsonOutput} />

    <h3 class="lesson-heading">4. Modify the Examples</h3>

    <p>
      Goal: output in ALL CAPS, by changing only the example (not the instructions). The model
      started in capitals and then switched back: <em>"READY FOR A FLAVOR EXPLOSION unlike any other?
      Dive headfirst into amazing Viet-Cajun Crawfish!…"</em>
    </p>

    <LessonCallout variant="warn" title="An example alone wasn't enough">
      <p>
        The model was still following its instructions: nothing told it to stay in capitals after
        starting with them. If you need a behavior, state it explicitly; don't rely on the model
        inferring it from an example.
      </p>
    </LessonCallout>

    <p>
      Changing one component at a time and examining the result makes prompt engineering more
      scientific. But components aren't always independent: both the Task and the Output Format
      can affect formatting, for example.
    </p>

    <h2 class="lesson-heading">Prompt Refinement Best Practices <SourceBadge source="course" /></h2>

    <p>
      <strong>Core idea:</strong> the more clarity and guidance you give, the less room the model has
      to fill gaps with its own interpretation, and the gaps are where unwanted output comes from.
      Think of a bakery with no shared recipe: every baker makes bread their own way. It might all be
      good bread, but not the bread you needed.
    </p>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Practice</th><th>Notes</th></tr>
        </thead>
        <tbody>
          <tr><td>Clear, detailed instructions</td><td>Tell it everything you want. Don't assume it can read your mind.</td></tr>
          <tr><td>Roles / personas</td><td>Sets tone and style (lesson 1.2).</td></tr>
          <tr><td>Break down complex tasks</td><td>Split into simpler stages; avoid convoluted requests. Ask it to think before answering (Chain-of-Thought), and you can <em>suggest the steps</em> it should take, as in the Demand-Spike prompt in 2.1.</td></tr>
          <tr><td>Output format + constraints</td><td>Structure (JSON, bullets) and limits: word count, language, phrases that must appear.</td></tr>
          <tr><td>Few-shot examples</td><td>Guide style, format, and how the task is done. Pair with explicit instructions (the ALL CAPS test).</td></tr>
          <tr><td>Relevant context</td><td>Whatever facts or specialist knowledge the task needs.</td></tr>
          <tr><td>Tool descriptions (agents)</td><td>Spend real time here. The model decides <em>when</em> and <em>how</em> to call a tool only from its description and input/output format.</td></tr>
        </tbody>
      </table>
    </div>

    <h2 class="lesson-heading">Common Pitfalls in Prompting <SourceBadge source="course" /></h2>

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Pitfall</th><th>What goes wrong</th><th>Fix</th></tr>
        </thead>
        <tbody>
          <tr><td>Ambiguity <em>(the most common)</em></td><td>Instructions open to several readings; the model picks one you didn't mean. Better future models still won't know instructions you never wrote.</td><td>Spell out length, audience, format, and what "good" means.</td></tr>
          <tr><td>Insufficient context</td><td>A guaranteed route to wrong or hallucinated output. The model has no access to your files or private, real-time data.</td><td>Put the facts in the prompt (or fetch them with tools, as in ReAct).</td></tr>
          <tr><td>Too much context / competing instructions</td><td>Irrelevant info and conflicting rules degrade performance.</td><td>Include only what the task needs; resolve conflicts before sending.</td></tr>
          <tr><td>Poor tool descriptions</td><td>The model calls the wrong tool, or the right one wrongly.</td><td>Say what it returns, when to use it, when not to, and argument formats.</td></tr>
          <tr><td>Expecting magical understanding</td><td>Probabilistic systems relying on explicit instructions, not mind readers. Don't trust the hype.</td><td>Be precise.</td></tr>
          <tr><td>Bias and factuality</td><td>Incorrect information; biases from training data.</td><td>Validate output, especially for critical tasks.</td></tr>
          <tr><td>Adversarial prompting</td><td>Prompt injection, leaking, jailbreaking.</td><td>Assume the model will be used in unintended ways; don't put secrets in prompts.</td></tr>
        </tbody>
      </table>
    </div>

    <p>
      Fixing these is iterative: write → test → analyze <em>why</em> it failed → refine. A prompt
      tuned for one LLM may need changes for another, even from the same company.
    </p>

    <h2 class="lesson-heading">Worked Example: From Vague to Structured <SourceBadge source="course" /></h2>

    <p>
      <strong>A longer prompt isn't automatically a better one.</strong> What matters is adding the
      <em>right kind</em> of detail, in a structured way. Scenario: an AI that categorizes incoming
      customer support emails for an automated ticketing system.
    </p>

    <h3 class="lesson-heading">Attempt 1: the vague prompt</h3>

    <CodeBlock lang="python" label="vague_prompt.py" code={vaguePrompt} />
    <CodeBlock lang="text" label="likely output" code={vagueOutput} />

    <p>
      The answer is <strong>correct but not useful</strong>. A downstream program can't reliably
      parse a free-text sentence to create a ticket, route it to the right department, or set its
      priority. Correctness wasn't the problem; structure was.
    </p>

    <h3 class="lesson-heading">Attempt 2: the refined prompt</h3>

    <p>Four components added: a Role, a clear Task, Context (what each category means), and a required Output Format.</p>

    <CodeBlock lang="python" label="refined_prompt.py" code={refinedPrompt} />
    <CodeBlock lang="json" label="likely output" code={refinedOutput} />

    <LessonDiagram definition={`
flowchart LR
  V["✍️ Vague prompt<br/>helpful assistant +<br/>please categorize"]:::warn --> VO["📝 One sentence<br/>correct, not parseable"]:::warn
  V -.->|"+ Role<br/>+ Task<br/>+ Context (categories)<br/>+ Output Format (JSON)"| R["🛠️ Refined prompt"]:::step
  R --> RO["✅ JSON object<br/>category, summary,<br/>urgency, customer_id"]:::done
  RO --> T["🎫 Ticketing system<br/>routes + prioritizes"]:::done

  classDef step fill:#dbeafe,color:#1e3a8a,stroke:#2563eb,stroke-width:2px
  classDef done fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px
  classDef warn fill:#fee2e2,color:#7f1d1d,stroke:#dc2626,stroke-width:2px
    `} />

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Added</th><th>In the prompt</th><th>Effect on the output</th></tr>
        </thead>
        <tbody>
          <tr><td>Role</td><td>Expert support agent categorizing for a ticketing system</td><td>Knows the output is for a machine, not a chat</td></tr>
          <tr><td>Task</td><td>Analyze the email, return structured JSON</td><td>One clear job instead of a free-form reply</td></tr>
          <tr><td>Context</td><td>Definitions of Billing / Technical Support / General Inquiry</td><td>Categories come from a fixed list with agreed meanings, not the model's own labels</td></tr>
          <tr><td>Output Format</td><td>Four keys, allowed values, "N/A" fallback</td><td>Parseable every time; a missing ID gets a defined value instead of an invented one</td></tr>
        </tbody>
      </table>
    </div>

    <LessonCallout variant="tip" title="Why this example matters for agents">
      <p>
        Most agent prompts feed code, not people. The refinement here is the same move as the
        Demand-Spike JSON block (2.1) and ReAct's fixed <code>ACT:</code> format: constrain the output
        so the next program in the chain can rely on it. Still validate it, though: the model can
        return a category outside the list, so check before routing.
      </p>
    </LessonCallout>

    <h3 class="lesson-heading">Going further: every best practice in one prompt</h3>

    <p>
      The course example adds four components. This one applies <em>all</em> the best practices to a
      similar task, turning a customer's support email into a handoff note for the on-call engineer,
      including the ones the course example skips: suggested steps, a few-shot example, and a rule for
      missing information.
    </p>

    <CodeBlock lang="text" label="before.txt" code={ticketBefore} />

    <p>
      Every important decision is left to the model: how long? for whom? which details matter? what
      format? Run it twice and you'll get two different shapes of summary, and nothing a program can
      parse.
    </p>

    <CodeBlock lang="text" label="after.txt" code={ticketAfter} />

    <div class="lesson-table">
      <table>
        <thead>
          <tr><th>Line in the new prompt</th><th>Best practice</th><th>Pitfall it prevents</th></tr>
        </thead>
        <tbody>
          <tr><td>"You are a support team lead…"</td><td>Role</td><td>Generic, chatty tone</td></tr>
          <tr><td>"…so the engineer can act without reading the original"</td><td>Clear, detailed instructions</td><td>Ambiguity about purpose and audience</td></tr>
          <tr><td>Steps 1–4</td><td>Break down the task (suggested CoT steps)</td><td>Missed details, e.g. error messages</td></tr>
          <tr><td>JSON keys, 2-sentence limit, urgency values</td><td>Output format + constraints</td><td>Unparseable, inconsistent output</td></tr>
          <tr><td>"If it isn't in the email, use null"</td><td>Constraint</td><td>Hallucinated details</td></tr>
          <tr><td>Example pair</td><td>Few-shot</td><td>Wrong level of detail</td></tr>
          <tr><td>Product list, urgency definition</td><td>Relevant context</td><td>The model guessing what "high" means</td></tr>
        </tbody>
      </table>
    </div>

    <p>
      Compared with the course version: the course defines its categories (Context) and output keys
      (Output Format). This one also defines what <em>"high"</em> means, tells the model what to do
      when a detail is missing, and shows one complete example, which closes the gaps where the
      model would otherwise guess.
    </p>

    <h3 class="lesson-heading">For agents: a tool description, refined</h3>

    <p>
      The same practices apply to tool descriptions, because they're part of the prompt the agent
      decides from:
    </p>

    <CodeBlock lang="text" label="tool-description.txt" code={toolBeforeAfter} />

    <p>
      The weak version leaves the model guessing what <code>id</code> is, what comes back, and whether
      this is the tool for a refund request. The refined one answers all three, which is what decides
      whether the ReAct loop in 2.1 picks the right tool.
    </p>

    <h2 class="lesson-heading">Example: Refining a Social Media Post <SourceBadge source="course" /></h2>

    <p>Goal: a social media post for the new "EverGreen" reusable coffee cup.</p>

    <LessonDiagram definition={`
flowchart LR
  S0["✍️ Initial task only"]:::step --> E0["❌ Too brief, no benefits,<br/>no call to action"]:::warn
  E0 --> S1["📚 + Context<br/>product benefits"]:::context --> E1["⚠️ Has benefits,<br/>tone dry, no CTA"]:::decision
  E1 --> S2["🎭 + Role<br/>📏 + Constraints"]:::role --> E2["✅ Engaging, benefits,<br/>emojis, call to action"]:::done

  classDef step     fill:#dbeafe,color:#1e3a8a,stroke:#2563eb,stroke-width:2px
  classDef context  fill:#ccfbf1,color:#134e4a,stroke:#0d9488,stroke-width:2px
  classDef role     fill:#ede9fe,color:#4c1d95,stroke:#7c3aed,stroke-width:2px
  classDef decision fill:#fef9c3,color:#713f12,stroke:#ca8a04,stroke-width:2px
  classDef done     fill:#dcfce7,color:#14532d,stroke:#16a34a,stroke-width:2px
  classDef warn     fill:#fee2e2,color:#7f1d1d,stroke:#dc2626,stroke-width:2px
    `} />

