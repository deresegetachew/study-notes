    <h2 class="lesson-heading">Checklist <SourceBadge source="course" /></h2>

    <LessonChecklist
      title="Building a feedback loop:"
      items={[
        '<strong>Define "good enough"</strong> — tests, rules, or a rubric the output must pass',
        '<strong>Pick the feedback source</strong> — external tool where possible (tests, linters), critique or user input where not',
        '<strong>Make feedback specific</strong> — input, expected, actual for every failure, not just FAIL',
        '<strong>Send the previous output with the feedback</strong> — FUNCTION + FEEDBACK',
