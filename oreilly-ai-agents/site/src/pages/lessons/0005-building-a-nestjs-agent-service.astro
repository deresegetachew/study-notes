    <h2 class="lesson-heading">Setup</h2>

    <CodeBlock lang="bash" label="terminal" code={`
nest new agent-api --package-manager npm
cd agent-api
npm install @anthropic-ai/sdk @nestjs/config class-validator class-transformer
nest g module agent
nest g controller agent --no-spec
nest g service agent --no-spec
    `} />

    <CodeBlock lang="typescript" label="src/main.ts" code={`
import { NestFactory } from '@nestjs/core';
import { ValidationPipe } from '@nestjs/common';
import { AppModule } from './app.module';

async function bootstrap() {
  const app = await NestFactory.create(AppModule);
  app.useGlobalPipes(new ValidationPipe({ whitelist: true }));
  await app.listen(3000);
}
bootstrap();
    `} />

    <h2 class="lesson-heading">1 — The DTO</h2>

    <p>
      NestJS equivalent of a Pydantic model. Validates the request body before it reaches
      your service — bad input is rejected at the boundary with a clear error.
    </p>

    <CodeBlock lang="typescript" label="src/agent/chat.dto.ts" code={`
import { IsString, IsNotEmpty, IsOptional, MaxLength } from 'class-validator';

export class ChatRequestDto {
  @IsString()
  @IsNotEmpty()
  @MaxLength(4000)
  message: string;

  @IsString()
  @IsOptional()
  threadId?: string; // omit to start a new thread
}

export class ChatResponseDto {
  reply: string;
  threadId: string;
}
    `} />

    <h2 class="lesson-heading">2 — The thread repository</h2>

    <p>
      In-memory for now. To swap to Postgres, replace the <code>Map</code> with a TypeORM or
      Prisma repository — the service code does not change.
    </p>

    <CodeBlock lang="typescript" label="src/agent/thread.repository.ts" code={`
import { Injectable } from '@nestjs/common';

export type Message = { role: 'user' | 'assistant'; content: string };

@Injectable()
export class ThreadRepository {
  private readonly store = new Map<string, Message[]>();

  load(threadId: string): Message[] {
    return this.store.get(threadId) ?? [];
  }

  save(threadId: string, messages: Message[]): void {
    this.store.set(threadId, messages);
  }
}
    `} />

    <h2 class="lesson-heading">3 — The agent service</h2>

    <p>
      The core. It combines the agent loop (L2), tool execution (L3), and thread persistence (L4)
      into one injectable service.
    </p>

    <CodeBlock lang="typescript" label="src/agent/agent.service.ts" code={`
import { Injectable } from '@nestjs/common';
import Anthropic from '@anthropic-ai/sdk';
import { randomUUID } from 'crypto';
import { ThreadRepository, Message } from './thread.repository';
import { ChatResponseDto } from './chat.dto';

@Injectable()
export class AgentService {
  private readonly client: Anthropic;

  // ── TOOL DEFINITIONS ───────────────────────────────────────────────────────
  private readonly tools: Anthropic.Tool[] = [
    {
      name: 'get_current_time',
      description:
        'Returns the current UTC date and time as an ISO 8601 string. ' +
        'Use when the user asks about the current time or date.',
      input_schema: { type: 'object', properties: {}, required: [] },
    },
    {
      name: 'calculate',
      description:
        'Evaluate a simple mathematical expression and return the numeric result. ' +
        'Use for arithmetic. Do NOT use for anything non-numeric.',
      input_schema: {
        type: 'object',
        properties: {
          expression: {
            type: 'string',
            description: 'A safe mathematical expression, e.g. "12 * 4 + 7"',
          },
        },
        required: ['expression'],
      },
    },
  ];

  constructor(private readonly threads: ThreadRepository) {
    this.client = new Anthropic({ apiKey: process.env.ANTHROPIC_API_KEY });
  }

  // ── TOOL EXECUTION ─────────────────────────────────────────────────────────
  private executeTool(name: string, input: Record<string, unknown>): string {
    switch (name) {
      case 'get_current_time':
        return new Date().toISOString();
      case 'calculate': {
        try {
          // Safe eval: only allow digits and math operators
          const expr = (input.expression as string).replace(/[^0-9+\\-*/.() ]/g, '');
          return String(Function('"use strict"; return (' + expr + ')')());
        } catch {
          return 'Error: invalid expression';
        }
      }
      default:
        return 'Unknown tool';
    }
  }

  // ── AGENT LOOP ─────────────────────────────────────────────────────────────
  async chat(userMessage: string, threadId?: string): Promise<ChatResponseDto> {
    const tid = threadId ?? randomUUID();
    const history = this.threads.load(tid);

    const messages: Anthropic.MessageParam[] = [
      ...history,
      { role: 'user', content: userMessage },
    ];

    let reply = '';

    while (true) {
      const response = await this.client.messages.create({
        model: 'claude-haiku-4-5-20251001',
        max_tokens: 1024,
        system: 'You are a helpful assistant. You have access to tools for time and arithmetic.',
        tools: this.tools,
        messages,
      });

      if (response.stop_reason === 'end_turn') {
        reply = response.content
          .filter(b => b.type === 'text')
          .map(b => b.text)
          .join('');
        break;
      }

      if (response.stop_reason === 'tool_use') {
        messages.push({ role: 'assistant', content: response.content });

        const results = response.content
          .filter(b => b.type === 'tool_use')
          .map(t => ({
            type: 'tool_result' as const,
            tool_use_id: t.id,
            content: this.executeTool(t.name, t.input as Record<string, unknown>),
          }));

        messages.push({ role: 'user', content: results });
      }
    }

    // Persist the updated thread
    this.threads.save(tid, [
      ...history,
      { role: 'user', content: userMessage },
      { role: 'assistant', content: reply },
    ]);

    return { reply, threadId: tid };
  }
}
    `} />

    <h2 class="lesson-heading">4 — The controller</h2>

    <p>
      Thin by design — validate input via the DTO, call the service, return. No agent logic lives here.
    </p>

    <CodeBlock lang="typescript" label="src/agent/agent.controller.ts" code={`
import { Body, Controller, Post } from '@nestjs/common';
import { AgentService } from './agent.service';
import { ChatRequestDto, ChatResponseDto } from './chat.dto';

@Controller('agent')
export class AgentController {
  constructor(private readonly agent: AgentService) {}

  @Post('chat')
  chat(@Body() dto: ChatRequestDto): Promise<ChatResponseDto> {
    return this.agent.chat(dto.message, dto.threadId);
  }
}
    `} />

    <h2 class="lesson-heading">5 — Wire up the module</h2>

    <CodeBlock lang="typescript" label="src/agent/agent.module.ts" code={`
import { Module } from '@nestjs/common';
import { AgentController } from './agent.controller';
import { AgentService } from './agent.service';
import { ThreadRepository } from './thread.repository';

@Module({
  controllers: [AgentController],
  providers: [AgentService, ThreadRepository],
})
export class AgentModule {}
    `} />

    <p>Import <code>AgentModule</code> into <code>AppModule</code> and set <code>ANTHROPIC_API_KEY</code> in your environment.</p>

    <h2 class="lesson-heading">Test it</h2>

    <CodeBlock lang="bash" label="terminal" code={`
npm run start:dev

# First message — no threadId, server creates one
curl -s -X POST http://localhost:3000/agent/chat \\
  -H "Content-Type: application/json" \\
  -d '{"message": "What time is it, and what is 144 divided by 12?"}' | jq

# Continue the thread — paste the threadId from above
curl -s -X POST http://localhost:3000/agent/chat \\
  -H "Content-Type: application/json" \\
  -d '{"message": "What was my first question?", "threadId": "PASTE-ID-HERE"}' | jq
    `} />

    <CodeBlock lang="json" label="expected response" code={`
{
  "reply": "The current UTC time is 2026-06-15T08:42:11.000Z. And 144 divided by 12 is 12.",
  "threadId": "f3a9c2b1-..."
}
    `} />

    <LessonCallout variant="tip" title="The loop is unchanged">
      <p>
        The LLM calls both tools in the same turn, your code executes them, results go back in,
        the LLM synthesises one answer. NestJS just gave you the HTTP envelope around the same
        loop from Lesson 2.
      </p>
    </LessonCallout>

    <h2 class="lesson-heading">Swapping the thread store for Postgres</h2>

    <p>
      When you need persistence across server restarts, replace <code>ThreadRepository</code>
      internals only. The service and controller do not change at all:
    </p>

    <CodeBlock lang="typescript" label="thread.repository.ts — Postgres version" code={`
@Injectable()
export class ThreadRepository {
  constructor(
    @InjectRepository(ThreadEntity)
    private repo: Repository<ThreadEntity>,
  ) {}

  async load(threadId: string): Promise<Message[]> {
    const thread = await this.repo.findOne({ where: { id: threadId } });
    return thread?.messages ?? [];
  }

  async save(threadId: string, messages: Message[]): Promise<void> {
    await this.repo.upsert({ id: threadId, messages }, ['id']);
  }
}
    `} />

    <h2 class="lesson-heading">Quick-check quiz</h2>

    <LessonQuiz questions={[
      {
        q:       'A new request arrives with no threadId in the body. What should the service do?',
        options: [
          'Generate a new UUID and start a fresh thread',
          'Return a 400 error — threadId is required',
          'Reuse the last thread ID seen by the server',
          'Send the message without any thread context',
        ],
        answer:  0,
        explain: 'No threadId means a new conversation. Generate a UUID, start with empty history, and return the new threadId so the client can continue the thread on the next request.',
      },
      {
        q:       'Where should you NOT put agent loop logic?',
        options: [
          'In the controller — it should stay thin and delegate',
          'In the service — it already has too much',
          'In the repository — persistence and logic can be combined',
          'Anywhere is fine — NestJS does not enforce separation',
        ],
        answer:  0,
        explain: 'Controllers are the HTTP boundary — validate, delegate, return. Putting agent logic there couples it to HTTP concerns and makes it harder to test independently.',
      },
      {
        q:       'You want to swap the in-memory thread store for Postgres. Which files need to change?',
        options: [
          'thread.repository.ts only — service and controller are decoupled from the storage layer',
          'agent.service.ts, agent.controller.ts, and thread.repository.ts',
          'agent.controller.ts only — it is closest to the request',
          'All files — the storage type affects the whole stack',
        ],
        answer:  0,
        explain: 'The repository is the only storage-aware layer. The service calls load() and save() without knowing whether those hit a Map or Postgres.',
      },
      {
        q:       'ValidationPipe({ whitelist: true }) is configured globally. A request arrives with { message: "hi", threadId: "abc", isAdmin: true }. What happens to isAdmin?',
        options: [
          'It is silently stripped — only DTO-defined fields are allowed',
          'It is passed through to the service as an extra field',
          'The request is rejected with a 400 error',
          'It is logged and then passed through',
        ],
        answer:  0,
        explain: 'whitelist: true strips any property not decorated in the DTO. isAdmin is silently removed — a useful security default. Add forbidNonWhitelisted: true if you want a 400 error instead.',
      },
    ]} />

  </div>

