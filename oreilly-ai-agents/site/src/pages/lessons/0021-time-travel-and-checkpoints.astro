  }
  .uc-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.1rem 1.25rem;
  }
  .uc-icon { font-size: 1.4rem; margin-bottom: .4rem; }
  .uc-title {
    font-weight: 700;
