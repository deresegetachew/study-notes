---
import LessonLayout    from '@/layouts/LessonLayout.astro';
import LessonHeader    from '@/components/LessonHeader.astro';
import LessonDiagram   from '@/components/LessonDiagram.astro';
import CodeBlock       from '@/components/CodeBlock.astro';
import LessonCallout   from '@/components/LessonCallout.astro';
import LessonChecklist from '@/components/LessonChecklist.astro';
import LessonQuiz      from '@/components/LessonQuiz.astro';
import DeepDive        from '@/components/DeepDive.astro';
import LessonMindMap   from '@/components/LessonMindMap.astro';

const errorHandlingCode = `
import Anthropic from '@anthropic-ai/sdk';

const client = new Anthropic();

// Typed error handling for every failure mode the API can throw
async function safeInvoke(prompt: string): Promise<string> {
  const MAX_RETRIES = 3;
  let attempt = 0;

  while (attempt < MAX_RETRIES) {
    try {
      const res = await client.messages.create({
        model: 'claude-opus-4-8',
        max_tokens: 1024,
        messages: [{ role: 'user', content: prompt }],
      });
      return res.content[0].type === 'text' ? res.content[0].text : '';

    } catch (err) {
      if (err instanceof Anthropic.APIError) {
        if (err.status === 429) {
          // Rate limit — exponential backoff with jitter to avoid thundering herd
          const jitter = Math.random() * 1000;
          const delay = Math.pow(2, attempt) * 1000 + jitter;
          console.warn(\`Rate limited. Retrying in \${Math.round(delay)}ms...\`);
          await new Promise(r => setTimeout(r, delay));
          attempt++;
          continue;
        }
        if (err.status === 529) {
          // API overloaded — short wait then retry
          await new Promise(r => setTimeout(r, 5000));
          attempt++;
          continue;
        }
        if (err.status === 400) {
          // Bad request — do NOT retry, fix the input
          throw new Error(\`Invalid request: \${err.message}\`);
        }
        if (err.status === 401 || err.status === 403) {
          // Auth error — fail immediately
          throw new Error('Authentication failed. Check ANTHROPIC_API_KEY.');
        }
      }
      throw err; // unexpected errors bubble up
    }
  }
  throw new Error('Max retries exceeded');
}
`.trim();

const guardrailsCode = `
import { z } from 'zod';

// ── Input guardrails ────────────────────────────────────────────────────────

const UserInput = z.object({
  message: z.string().min(1).max(4000),
  userId:  z.string().uuid(),
});

function sanitiseInput(raw: unknown) {
  const parsed = UserInput.parse(raw); // throws ZodError on violation

  // Basic prompt injection defence: reject if input tries to override system
  const INJECTION_PATTERNS = [
    /ignore (?:previous|all) instructions/i,
    /you are now/i,
    /act as (?:an? )?(?:unrestricted|jailbreak)/i,
  ];
  if (INJECTION_PATTERNS.some(p => p.test(parsed.message))) {
    throw new Error('Input rejected: policy violation.');
  }
  return parsed;
}

// ── Output guardrails ───────────────────────────────────────────────────────

const AgentOutput = z.object({
  action:   z.enum(['search', 'summarise', 'done']),
  query:    z.string().optional(),
  result:   z.string().optional(),
});

async function invokeWithOutputGuard(prompt: string) {
  const raw = await safeInvoke(prompt);

  // Parse JSON output — if the model didn't return valid JSON, reject
  let parsed: unknown;
  try {
    parsed = JSON.parse(raw);
  } catch {
    throw new Error('Model returned non-JSON output. Prompt may need adjustment.');
  }

  return AgentOutput.parse(parsed); // throws if schema violated
}
`.trim();

const mindMap = `
