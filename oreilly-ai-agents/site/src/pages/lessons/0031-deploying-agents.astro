const nestjsDeployCode = `
// NestJS agent service — production-ready structure
// src/agent/agent.module.ts

import { Module } from '@nestjs/common';
import { BullModule } from '@nestjs/bullmq';
import { AgentController } from './agent.controller';
import { AgentService }    from './agent.service';
import { AgentProcessor }  from './agent.processor';

@Module({
  imports: [
    BullModule.registerQueue({ name: 'agent-tasks' }),
  ],
  controllers: [AgentController],
  providers:   [AgentService, AgentProcessor],
})
export class AgentModule {}

// ── Controller: HTTP interface ────────────────────────────────────────────────
// src/agent/agent.controller.ts

import { Controller, Post, Get, Param, Body } from '@nestjs/common';
import { InjectQueue } from '@nestjs/bullmq';
import { Queue } from 'bullmq';

@Controller('agent')
export class AgentController {
  constructor(@InjectQueue('agent-tasks') private queue: Queue) {}

  @Post('tasks')
  async createTask(@Body() body: { goal: string; userId: string }) {
    const job = await this.queue.add('run', body, {
      attempts:    3,
      backoff:     { type: 'exponential', delay: 2000 },
      removeOnComplete: { age: 60 * 60 * 24 }, // keep 24h
    });
    return { taskId: job.id };
  }

  @Get('tasks/:id')
  async getTask(@Param('id') id: string) {
    const job = await this.queue.getJob(id);
    if (!job) return { error: 'Not found' };
    return {
      id:       job.id,
      status:   await job.getState(),
      progress: job.progress,
      result:   job.returnvalue,
    };
  }
}

// ── Processor: background worker ─────────────────────────────────────────────
// src/agent/agent.processor.ts

import { Processor, WorkerHost } from '@nestjs/bullmq';
import { Job } from 'bullmq';

@Processor('agent-tasks')
export class AgentProcessor extends WorkerHost {
  constructor(private agentService: AgentService) { super(); }

  async process(job: Job<{ goal: string; userId: string }>) {
    await job.updateProgress(0);

    const result = await this.agentService.run(
      job.data.goal,
      job.data.userId,
      (pct) => job.updateProgress(pct), // progress callback
    );

    return result;
  }
}
`.trim();

const sseCode = `
import { Controller, Get, Param, Sse, MessageEvent } from '@nestjs/common';
import { InjectQueue } from '@nestjs/bullmq';
import { Queue } from 'bullmq';
import { Observable, interval, from } from 'rxjs';
import { switchMap, takeWhile, map } from 'rxjs/operators';

@Controller('agent')
export class AgentController {
  constructor(@InjectQueue('agent-tasks') private queue: Queue) {}

  // SSE endpoint — browser connects once, receives events as they happen
  @Sse('tasks/:id/stream')
  streamTaskProgress(@Param('id') id: string): Observable<MessageEvent> {
    return interval(500).pipe(
      switchMap(() => from(this.queue.getJob(id))),
      takeWhile(job => !!job, true), // complete when job disappears
      map(job => ({
        data: {
          status:   job ? 'pending'    : 'not_found',
          progress: job?.progress      ?? 0,
          result:   job?.returnvalue   ?? null,
        },
      })),
    );
  }
}

// Client-side (browser): one-liner to consume the stream
// const es = new EventSource('/agent/tasks/123/stream');
// es.onmessage = (e) => console.log(JSON.parse(e.data));
`.trim();

const dockerCode = `
# Dockerfile — multi-stage build for a NestJS agent service
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Non-root user for security
RUN addgroup -g 1001 -S nodejs && adduser -S nestjs -u 1001
COPY --from=builder --chown=nestjs:nodejs /app/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/package.json ./

USER nestjs
EXPOSE 3000

# Healthcheck — Cloud Run / ECS will replace unhealthy instances
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \\
  CMD node -e "require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode === 200 ? 0 : 1))"

CMD ["node", "dist/main.js"]
`.trim();

