const sequentialCode = `
import { StateGraph, START, END } from '@langchain/langgraph';
import { Annotation } from '@langchain/langgraph';
import Anthropic from '@anthropic-ai/sdk';

const client = new Anthropic();

// A sequential pipeline: each node depends on the previous node's output.
// Real-world use: customer feedback processing — detect language → classify
// sentiment → summarise → assemble a structured report.

const PipelineState = Annotation.Root({
  rawText:   Annotation<string>({ reducer: (_, n) => n, default: () => '' }),
  language:  Annotation<string>({ reducer: (_, n) => n, default: () => '' }),
  sentiment: Annotation<string>({ reducer: (_, n) => n, default: () => '' }),
  summary:   Annotation<string>({ reducer: (_, n) => n, default: () => '' }),
  report:    Annotation<string>({ reducer: (_, n) => n, default: () => '' }),
});

// Step 1 — detect language (fast, cheap, Haiku)
async function detectLanguage(state: typeof PipelineState.State) {
  const res = await client.messages.create({
    model: 'claude-haiku-4-5-20251001',
    max_tokens: 16,
    messages: [{
      role: 'user',
      content: \`What language is this? Reply with only the language name.\\n\${state.rawText}\`,
    }],
  });
  return { language: res.content[0].type === 'text' ? res.content[0].text.trim() : 'English' };
}

// Step 2 — classify sentiment (uses language from step 1)
async function classifySentiment(state: typeof PipelineState.State) {
  const res = await client.messages.create({
    model: 'claude-haiku-4-5-20251001',
    max_tokens: 16,
    messages: [{
      role: 'user',
      content: \`Classify sentiment as positive/negative/neutral. One word only. Language: \${state.language}\\n\${state.rawText}\`,
    }],
  });
  return { sentiment: res.content[0].type === 'text' ? res.content[0].text.trim() : 'neutral' };
}

// Step 3 — one-sentence summary (uses both language and sentiment)
async function summarise(state: typeof PipelineState.State) {
  const res = await client.messages.create({
    model: 'claude-haiku-4-5-20251001',
    max_tokens: 128,
    messages: [{
      role: 'user',
      content: \`Summarise in one sentence. Language: \${state.language}\\n\${state.rawText}\`,
    }],
  });
  return { summary: res.content[0].type === 'text' ? res.content[0].text : '' };
}

// Step 4 — assemble structured report (pure function, no LLM needed)
function buildReport(state: typeof PipelineState.State) {
  return {
    report: JSON.stringify(
      { language: state.language, sentiment: state.sentiment, summary: state.summary },
      null, 2
    ),
  };
}

const pipeline = new StateGraph(PipelineState)
  .addNode('detectLanguage',    detectLanguage)
  .addNode('classifySentiment', classifySentiment)
  .addNode('summarise',         summarise)
  .addNode('buildReport',       buildReport)
  .addEdge(START, 'detectLanguage')
  .addEdge('detectLanguage',    'classifySentiment')
  .addEdge('classifySentiment', 'summarise')
  .addEdge('summarise',         'buildReport')
  .addEdge('buildReport',       END)
  .compile();

const result = await pipeline.invoke({ rawText: 'Das Produkt kam beschädigt an...' });
console.log(result.report);
// {"language":"German","sentiment":"negative","summary":"The product arrived damaged."}
`.trim();

const parallelCode = `
import { StateGraph, START, END } from '@langchain/langgraph';
import { Annotation, Send } from '@langchain/langgraph';
import Anthropic from '@anthropic-ai/sdk';

const client = new Anthropic();

// Fan-out / Fan-in: N items processed in parallel, results accumulated.
// Real-world use: batch review analysis — analyze all reviews simultaneously
// instead of sequentially. 4 reviews × 3s = 3s (parallel) vs 12s (sequential).

interface ReviewResult {
  sentiment: 'positive' | 'negative' | 'neutral';
  score:     number;   // 1–5
  summary:   string;
}

// Parent state — the results field uses an ADD reducer so parallel outputs accumulate
const BatchState = Annotation.Root({
  reviews: Annotation<string[]>({
    reducer:  (_, next) => next,
    default:  () => [],
  }),
  results: Annotation<ReviewResult[]>({
    reducer:  (prev, next) => [...prev, ...next],  // KEY: accumulates from all branches
    default:  () => [],
  }),
});

// Worker state — one Send carries this into the analyzeReview node
const WorkerState = Annotation.Root({
  review:  Annotation<string>({         reducer: (_, n) => n, default: () => ''  }),
  results: Annotation<ReviewResult[]>({ reducer: (a, b) => [...a, ...b], default: () => [] }),
});

// ROUTER: return one Send per review — LangGraph executes them all in parallel
function fanOut(state: typeof BatchState.State): Send[] {
  return state.reviews.map(
    (review) => new Send('analyzeReview', { review, results: [] })
  );
}

// WORKER NODE: called once per review, in parallel
async function analyzeReview(state: typeof WorkerState.State) {
  const res = await client.messages.create({
    model:      'claude-haiku-4-5-20251001',
    max_tokens: 128,
    system:     'Reply with JSON only: {"sentiment":"positive|negative|neutral","score":1,"summary":"..."}',
    messages:   [{ role: 'user', content: state.review }],
  });
  try {
    const raw    = res.content[0].type === 'text' ? res.content[0].text : '{}';
    const parsed = JSON.parse(raw) as ReviewResult;
    return { results: [parsed] };  // wrap in array — the add reducer accumulates across branches
  } catch {
    return { results: [{ sentiment: 'neutral', score: 3, summary: 'parse error' }] };
  }
}

// AGGREGATOR NODE: all parallel results are already merged in state.results by the time we arrive here
function aggregate(state: typeof BatchState.State) {
  const avg = state.results.reduce((s, r) => s + r.score, 0) / state.results.length;
  console.log(\`Processed \${state.results.length} reviews | avg score: \${avg.toFixed(1)}/5\`);
  return {};
}

const graph = new StateGraph(BatchState)
  .addNode('analyzeReview', analyzeReview)
  .addNode('aggregate',     aggregate)
  .addConditionalEdges(START,          fanOut)        // fan-out: N parallel branches via Send
  .addEdge('analyzeReview',            'aggregate')   // fan-in: all branches converge here
  .addEdge('aggregate',                END)
  .compile();

const result = await graph.invoke({
  reviews: [
    'Arrived damaged — very disappointed.',
    'Exactly as described, fast shipping!',
    'Average product, does the job.',
  ],
  results: [],
});
// Processed 3 reviews | avg score: 3.0/5
`.trim();

const subgraphCode = `
import { StateGraph, START, END } from '@langchain/langgraph';
import { Annotation } from '@langchain/langgraph';
import Anthropic from '@anthropic-ai/sdk';

const client = new Anthropic();

// Subgraph composition: a self-contained sub-workflow with its OWN state shape
// is compiled and invoked from a node in the parent graph.
// Real-world use: entity extraction subgraph reused inside a document processor,
// a summarizer, and a classification pipeline — without duplicating the logic.

// ── SUBGRAPH: Entity Extraction ──────────────────────────────────────────────
// Owns a different state shape from the parent — this is the key benefit.
const ExtractionState = Annotation.Root({
  text:     Annotation<string>({   reducer: (_, n) => n, default: () => '' }),
  rawJson:  Annotation<string>({   reducer: (_, n) => n, default: () => '' }),
  entities: Annotation<string[]>({ reducer: (_, n) => n, default: () => [] }),
});

async function extractRaw(state: typeof ExtractionState.State) {
  const res = await client.messages.create({
    model:      'claude-haiku-4-5-20251001',
    max_tokens: 256,
    system:     'Extract named entities (people, places, orgs). Reply with a JSON array of strings only.',
    messages:   [{ role: 'user', content: state.text }],
  });
  return { rawJson: res.content[0].type === 'text' ? res.content[0].text : '[]' };
}

function parseEntities(state: typeof ExtractionState.State) {
  try {
    return { entities: JSON.parse(state.rawJson) as string[] };
  } catch {
    return { entities: [] };
  }
}

// Compile the subgraph — it becomes a standalone callable unit.
const extractionSubgraph = new StateGraph(ExtractionState)
  .addNode('extractRaw',    extractRaw)
  .addNode('parseEntities', parseEntities)
  .addEdge(START,           'extractRaw')
  .addEdge('extractRaw',    'parseEntities')
  .addEdge('parseEntities', END)
  .compile();

// ── PARENT GRAPH: Document Processor ────────────────────────────────────────
const DocumentState = Annotation.Root({
  document: Annotation<string>({   reducer: (_, n) => n, default: () => '' }),
  entities: Annotation<string[]>({ reducer: (_, n) => n, default: () => [] }),
  summary:  Annotation<string>({   reducer: (_, n) => n, default: () => '' }),
});

// Bridge function: translates parent state → subgraph state → back to parent state
async function runExtraction(state: typeof DocumentState.State) {
  const out = await extractionSubgraph.invoke({
    text:     state.document,
    rawJson:  '',
    entities: [],
  });
  return { entities: out.entities };   // map subgraph output back to parent state field
}

async function summarise(state: typeof DocumentState.State) {
  const entityList = state.entities.join(', ') || 'no named entities';
  const res = await client.messages.create({
    model:      'claude-haiku-4-5-20251001',
    max_tokens: 128,
    messages:   [{
      role: 'user',
      content: \`Summarise this in one sentence, mentioning: \${entityList}\\n\${state.document}\`,
    }],
  });
  return { summary: res.content[0].type === 'text' ? res.content[0].text : '' };
}

const docProcessor = new StateGraph(DocumentState)
  .addNode('runExtraction', runExtraction)
  .addNode('summarise',     summarise)
  .addEdge(START,           'runExtraction')
  .addEdge('runExtraction', 'summarise')
  .addEdge('summarise',     END)
  .compile();

const result = await docProcessor.invoke({
  document: 'Anthropic and OpenAI both announced new model releases this week in San Francisco.',
  entities: [],
  summary:  '',
});
// entities: ['Anthropic', 'OpenAI', 'San Francisco']
// summary:  'Anthropic and OpenAI each released new models in San Francisco this week.'
`.trim();

