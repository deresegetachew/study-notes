const statelessWorkerCode = `
// Stateless worker pattern — no local state, everything in Redis/Postgres
//
// Anti-pattern: storing state on the worker
class BadAgentWorker {
  private sessions = new Map<string, AgentSession>();  // ❌ dies on restart

  async process(jobId: string) {
    const session = this.sessions.get(jobId);          // ❌ only works on THIS worker
    // ...
  }
}

// Correct: externalise all state
class StatelessAgentWorker {
  constructor(
    private redis:    RedisClient,
    private postgres: PostgresClient,
  ) {}

  async process(job: { id: string; threadId: string; input: string }) {
    // Fetch context from shared store — works on any worker
    const context = await this.redis.get(\`session:\${job.threadId}\`);
    const history = await this.postgres.query(
      'SELECT * FROM checkpoints WHERE thread_id = $1 ORDER BY created_at',
      [job.threadId],
    );

    // Run agent
    const result = await runAgent(job.input, context, history);

    // Save back — next step can run on any worker
    await this.redis.set(\`session:\${job.threadId}\`, result.context, 'EX', 3600);
    await this.postgres.query(
      'INSERT INTO checkpoints (thread_id, state, created_at) VALUES ($1, $2, NOW())',
      [job.threadId, result.state],
    );

    return result.output;
  }
}
`.trim();

const costControlCode = `
// Token budget enforcement — hard cap per user per time window
class TokenBudgetGuard {
  constructor(private redis: RedisClient) {}

  async checkBudget(
    userId:    string,
    estimated: number,
    limit:     number = 100_000,   // tokens per day
  ): Promise<void> {
    const key   = \`tokens:\${userId}:\${today()}\`;
    const used  = parseInt((await this.redis.get(key)) ?? '0', 10);

    if (used + estimated > limit) {
      throw new Error(\`Token budget exceeded for \${userId}: \${used}/\${limit} used today\`);
    }
  }

  async recordUsage(userId: string, tokensUsed: number): Promise<void> {
    const key = \`tokens:\${userId}:\${today()}\`;
    await this.redis.incrby(key, tokensUsed);
    await this.redis.expire(key, 86_400);   // TTL: 24 hours
  }
}

function today(): string {
  return new Date().toISOString().slice(0, 10);
}

// Concurrency limiter — max parallel tasks per tenant
async function acquireConcurrencySlot(
  redis: RedisClient,
  tenantId: string,
  maxConcurrent: number = 5,
): Promise<boolean> {
  const key     = \`concurrency:\${tenantId}\`;
  const current = parseInt((await redis.get(key)) ?? '0', 10);
  if (current >= maxConcurrent) return false;
  await redis.incr(key);
  await redis.expire(key, 300);   // safety TTL
  return true;
}
`.trim();

const mindMap = `
# Scaling Agents
## Horizontal vs Vertical
