const debugCode = `
import { StateGraph, END } from '@langchain/langgraph';
import { Annotation } from '@langchain/langgraph';

// Middleware: wrap every node to log state before and after
function withDebug<S extends object>(
  name: string,
  fn: (state: S) => Promise<Partial<S>>,
) {
  return async (state: S): Promise<Partial<S>> => {
    console.log(\`[ENTER \${name}]\`, JSON.stringify(state, null, 2));
    const update = await fn(state);
    console.log(\`[EXIT \${name}]\`, JSON.stringify(update, null, 2));
    return update;
  };
}

// Validation: assert invariants on state before each node runs
function withValidation<S extends Record<string, unknown>>(
  name: string,
  checks: Array<(s: S) => boolean | string>,
  fn: (state: S) => Promise<Partial<S>>,
) {
  return async (state: S): Promise<Partial<S>> => {
    for (const check of checks) {
      const result = check(state);
      if (result !== true) {
        const msg = typeof result === 'string' ? result : \`Invariant failed in \${name}\`;
        throw new Error(msg);
      }
    }
    return fn(state);
  };
}

// Example usage: wrap nodes when debugging
const AgentState = Annotation.Root({
  messages:  Annotation<string[]>({ reducer: (p, n) => [...p, ...n], default: () => [] }),
  iteration: Annotation<number>({ reducer: (_, n) => n, default: () => 0 }),
  status:    Annotation<string>({ reducer: (_, n) => n, default: () => 'running' }),
});

async function rawModel(state: typeof AgentState.State) {
  // ... LLM call
  return { messages: ['model response'], iteration: state.iteration + 1 };
}

// In development, wrap with debug middleware
const modelNode = process.env.NODE_ENV === 'development'
  ? withDebug('model', withValidation(
      'model',
      [
        s => s.iteration < 10 || 'Too many iterations — possible infinite loop',
        s => s.messages.length < 100 || 'Message history too long',
      ],
      rawModel,
    ))
  : rawModel;
`.trim();

const streamDebugCode = `
// Stream individual node outputs to observe state transitions live
const graph = buildGraph().compile();

const input = { messages: ['Hello'], iteration: 0, status: 'running' };

for await (const chunk of await graph.stream(input, { streamMode: 'updates' })) {
  // chunk is { nodeName: partialStateUpdate }
  const [nodeName, update] = Object.entries(chunk)[0];
  console.log(\`Node "\${nodeName}" updated state:\`, update);
}

// Stream mode options:
// 'updates'  — emit partial state from each node as it completes (most useful for debugging)
// 'values'   — emit full state after each node
// 'debug'    — emit internal LangGraph events (tasks, checkpoints)
`.trim();

const interruptDebugCode = `
import { interrupt }    from '@langchain/langgraph';
import { MemorySaver }  from '@langchain/langgraph';

// Step 1: drop interrupt() inside any node like a debugger breakpoint
async function classifyNode(state: typeof ModerationState.State) {
  const result = await classifier.invoke(state.content);

  // Pause here in dev so you can inspect the classification before routing continues
  if (process.env.NODE_ENV === 'development') {
    interrupt({
      message:    'Classification complete — inspect before routing',
      category:   result.category,
      confidence: result.confidence,
      content:    state.content,
    });
  }

  return { category: result.category, confidence: result.confidence };
}

// Step 2: compile with a checkpointer — required for interrupt support
const graph = new StateGraph(ModerationState)
  .addNode('classify', classifyNode)
  .addNode('approve',  approveNode)
  .addNode('review',   reviewNode)
  .addNode('block',    blockNode)
  .addConditionalEdges('classify', routeByCategory, { approve: 'approve', review: 'review', block: 'block' })
  .compile({ checkpointer: new MemorySaver() });

const config = { configurable: { thread_id: 'debug-1' } };

// Step 3: Phase 1 — invoke runs until the interrupt fires
const paused = await graph.invoke({ content: 'This product is amazing!' }, config);

// paused.__interrupt__ contains the payload you passed to interrupt()
console.log('Paused at:', paused.__interrupt__[0].value);
// → { message: 'Classification complete...', category: 'safe', confidence: 0.94, ... }

// Step 4: inspect the full checkpoint state at the breakpoint
const snapshot = await graph.getState(config);
console.log('Full state:', snapshot.values);   // everything in state right now
console.log('Next node:',  snapshot.next);     // ['approve'] — where it will go on resume

// Step 5 (optional): patch state before resuming — override the classification
await graph.updateState(config, { category: 'review' });

// Step 6: resume — pass null input + same config; execution picks up after the interrupt
const final = await graph.invoke(null, config);
console.log('Final output:', final.finalOutput);
`.trim();


const traceDecoratorCode = `
import { Logger } from '@nestjs/common';

// Pattern 2: @TraceNode() method decorator — most idiomatic for NestJS
// Decorates class methods that serve as graph nodes
export function TraceNode(label?: string): MethodDecorator {
  return (_target, propertyKey, descriptor: PropertyDescriptor) => {
    const original = descriptor.value as (state: unknown) => Promise<unknown>;
    const name     = label ?? String(propertyKey);

    descriptor.value = async function (state: unknown) {
      if (process.env.NODE_ENV !== 'development') {
        return original.call(this, state);  // no-op in production
      }
      Logger.debug(\`[ENTER \${name}]\`, JSON.stringify(state, null, 2), 'TraceNode');
      const update = await original.call(this, state);
      Logger.debug(\`[EXIT  \${name}]\`, JSON.stringify(update, null, 2), 'TraceNode');
      return update;
    };

    return descriptor;
  };
}

// Usage: annotate node methods on a class-based service
@Injectable()
export class ChatNodes {
  @TraceNode()                   // uses method name 'classifier' as label
  async classifier(state: typeof ChatState.State) {
    // ... Haiku call
  }

  @TraceNode('specialist-node')  // explicit label
  async specialist(state: typeof ChatState.State) {
    // ... Sonnet call
  }
}
`.trim();

const interceptorCode = `
import { Injectable, NestInterceptor, ExecutionContext,
         CallHandler, Logger, UseInterceptors } from '@nestjs/common';
import { Observable } from 'rxjs';
import { tap } from 'rxjs/operators';

// Pattern 3: NestJS Interceptor — HTTP-level observability on the agent endpoint
// Use this to log what came in and what the graph produced, without touching graph code
@Injectable()
export class AgentTraceInterceptor implements NestInterceptor {
  private readonly logger = new Logger('AgentTrace');

  intercept(ctx: ExecutionContext, next: CallHandler): Observable<unknown> {
    const req      = ctx.switchToHttp().getRequest<Request>();
    const body     = req.body as Record<string, string>;
    const threadId = body.threadId ?? 'unknown';
    const start    = Date.now();

    this.logger.log(\`→ [\${threadId}] \${req.method} \${req.url}\`);

    return next.handle().pipe(
      tap(result => {
        const ms = Date.now() - start;
        this.logger.log(
          \`← [\${threadId}] \${ms}ms | guardrail=\${result?.guardrailPassed} | \` +
          \`citations=\${result?.citations?.length ?? 0}\`,
        );
      }),
    );
  }
}

@Controller('agent')
@UseInterceptors(AgentTraceInterceptor)
export class AgentController {
  @Post('ask')
  async ask(@Body() dto: AskDto) { /* ... */ }
}
`.trim();

const ex1BugCode = `
const ChatState = Annotation.Root({
  messages:  Annotation<string[]>({ reducer: (_, n) => n, default: () => [] }),
  turnCount: Annotation<number>({  reducer: (_, n) => n, default: () => 0 }),
});

async function modelNode(state: typeof ChatState.State) {
  const reply = await callLLM(state.messages);
  return {
    messages:  [reply],
    turnCount: state.turnCount + 1,
  };
}

// After running 3 turns you observe in the stream:
// Node "modelNode" → { messages: ["Turn 1 reply"], turnCount: 1 }
// Node "modelNode" → { messages: ["Turn 2 reply"], turnCount: 2 }
// Node "modelNode" → { messages: ["Turn 3 reply"], turnCount: 3 }
//
// Final state: messages = ["Turn 3 reply"]   ← only 1 message, expected 3
//              turnCount = 3                  ← correct
`.trim();

const ex1FixCode = `
const ChatState = Annotation.Root({
  // Bug: (_, n) => n is a REPLACE reducer — it discards the previous array.
  // Fix: use an ACCUMULATING reducer to append new messages to the history.
  messages:  Annotation<string[]>({ reducer: (prev, next) => [...prev, ...next], default: () => [] }),
  turnCount: Annotation<number>({  reducer: (_, n) => n, default: () => 0 }),
});

// Now state.messages accumulates across turns:
// After turn 1: ["Turn 1 reply"]
// After turn 2: ["Turn 1 reply", "Turn 2 reply"]
// After turn 3: ["Turn 1 reply", "Turn 2 reply", "Turn 3 reply"]
`.trim();

const ex2AnswerCode = `
export function TraceNode(label?: string): MethodDecorator {
  return (_target, propertyKey, descriptor: PropertyDescriptor) => {
    const original = descriptor.value as (state: unknown) => Promise<unknown>;
    const name     = label ?? String(propertyKey);

