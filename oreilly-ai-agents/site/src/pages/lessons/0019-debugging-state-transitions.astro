const ex3BugCode = `
// You enable streamMode: 'updates' and see this in the console:
//
// Node "triage" updated state: { category: "BILLING" }
// RuntimeError: No target found for route key "BILLING"

// Your graph:
function routeByCategory(state: typeof TriageState.State): string {
  return state.category;
}

const graph = new StateGraph(TriageState)
  .addConditionalEdges('triage', routeByCategory, {
    billing:  'billingAgent',
    shipping: 'shippingAgent',
    general:  'generalAgent',
  });

// The triage node returns: { category: "BILLING" }
// Spot the bug and write the one-line fix.
`.trim();

const ex3FixCode = `
// Bug: the LLM returned uppercase "BILLING" but the edge map keys are lowercase "billing".
// Conditional edge routing is case-sensitive — "BILLING" !== "billing".

// Fix: normalise the router output before it hits the map
function routeByCategory(state: typeof TriageState.State): string {
  return state.category.toLowerCase().trim();  // "BILLING" → "billing"
}

// Defence in depth: the 'general' key in the edge map is already your fallback
// for unrecognised or misspelled categories — never omit it.
`.trim();

