const taskFileSchemaCode = `
// Each task lives as a single markdown file under .tasks/open/ or .tasks/closed/
// YAML frontmatter = structured metadata (filterable, sortable)
// Markdown body = human-readable description, acceptance criteria, notes

---
id: T-0042
title: Fix authentication race condition under concurrent requests
status: open             # open | in-progress | blocked | closed
priority: high           # critical | high | medium | low
tags: [auth, security, backend]
assignee: deresegetachew
estimated_hours: 4
linked_files:
  - src/auth/middleware.ts
  - src/auth/session.ts
created: 2026-06-01T09:00:00Z
updated: 2026-06-18T14:23:00Z
---

## Description
Under concurrent login requests for the same user, two sessions can be created
before the first write commits. Observed at > 50 concurrent requests in load test.

## Acceptance criteria
- [ ] Concurrent requests for the same user produce exactly one session
- [ ] Existing single-request login flow is unaffected
- [ ] Load test at 200 concurrent requests passes

## Notes
- Redis SETNX may solve this — see src/auth/middleware.ts:L42
`;

const taskMcpServerCode = `
// task-manager-server.ts
// Custom MCP server for structured task operations.
// Runs via stdio — spawned as a child process by the agent.
// Understands the .tasks/ schema; validates frontmatter on every write.

import { Server }              from '@modelcontextprotocol/sdk/server/index.js';
import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
import {
  ListToolsRequestSchema,     CallToolRequestSchema,
  ListResourcesRequestSchema, ReadResourceRequestSchema,
} from '@modelcontextprotocol/sdk/types.js';
import { z }    from 'zod';
import * as fs  from 'node:fs/promises';
import * as path from 'node:path';
import matter   from 'gray-matter';

// Resolved at startup from the Root the client declares
let projectRoot = process.env.PROJECT_ROOT ?? process.cwd();

const server = new Server(
  { name: 'task-manager-server', version: '1.0.0' },
  { capabilities: { tools: {}, resources: {} } },
);

// ── TOOLS ────────────────────────────────────────────────────────────────────
server.setRequestHandler(ListToolsRequestSchema, async () => ({
  tools: [
    {
      name: 'list_tasks',
      description: 'List task files. Filter by status, priority, tags, or assignee. Returns frontmatter only — call get_task for the full body.',
      inputSchema: {
        type: 'object',
        properties: {
          status:   { type: 'string', enum: ['open', 'in-progress', 'blocked', 'closed'] },
          priority: { type: 'string', enum: ['critical', 'high', 'medium', 'low'] },
          tags:     { type: 'array', items: { type: 'string' } },
          assignee: { type: 'string' },
        },
      },
    },
    {
      name: 'get_task',
      description: 'Read a specific task file by ID. Returns full frontmatter + markdown body.',
      inputSchema: {
        type: 'object',
        properties: { task_id: { type: 'string' } },
        required: ['task_id'],
      },
    },
    {
      name: 'create_task',
      description: 'Write a new task file under .tasks/open/. Validates frontmatter schema before writing. Returns the assigned task ID.',
      inputSchema: {
        type: 'object',
        properties: {
          title:        { type: 'string' },
          description:  { type: 'string' },
          priority:     { type: 'string', enum: ['critical', 'high', 'medium', 'low'] },
          tags:         { type: 'array', items: { type: 'string' } },
          assignee:     { type: 'string' },
          linked_files: { type: 'array', items: { type: 'string' } },
        },
        required: ['title', 'description', 'priority'],
      },
    },
    {
      name: 'update_task',
      description: 'Update frontmatter fields on an existing task. Only the specified fields are changed; all others are preserved.',
      inputSchema: {
        type: 'object',
        properties: {
          task_id: { type: 'string' },
          changes: {
            type: 'object',
            properties: {
              status:        { type: 'string' },
              priority:      { type: 'string' },
              assignee:      { type: 'string' },
              tags:          { type: 'array', items: { type: 'string' } },
              linked_files:  { type: 'array', items: { type: 'string' } },
              estimated_hours: { type: 'number' },
            },
          },
        },
        required: ['task_id', 'changes'],
      },
    },
    {
      name: 'close_task',
      description: 'Move a task from .tasks/open/ to .tasks/closed/ and set status=closed. Irreversible — only call after human confirmation.',
      inputSchema: {
        type: 'object',
        properties: {
          task_id:    { type: 'string' },
          resolution: { type: 'string', description: 'One sentence describing how the task was resolved' },
        },
        required: ['task_id', 'resolution'],
      },
    },
    {
      name: 'search_tasks',
      description: 'Full-text search over task titles and descriptions. Use for semantic queries like "tasks related to the login flow". For structured filters (by tag, status, priority) use list_tasks instead.',
      inputSchema: {
        type: 'object',
        properties: {
          query:  { type: 'string' },
          status: { type: 'string', enum: ['open', 'in-progress', 'blocked', 'closed', 'all'], default: 'all' },
        },
        required: ['query'],
      },
    },
  ],
}));

// ── RESOURCES — task files exposed as MCP Resources ──────────────────────────
// Every task file is addressable by URI. The agent can subscribe to changes
// (listChanged: true) so it knows when tasks are modified outside the session.
server.setRequestHandler(ListResourcesRequestSchema, async () => {
  const openDir   = path.join(projectRoot, '.tasks', 'open');
  const closedDir = path.join(projectRoot, '.tasks', 'closed');
  const [openFiles, closedFiles] = await Promise.all([
    fs.readdir(openDir).catch(() => []),
    fs.readdir(closedDir).catch(() => []),
  ]);
  return {
    resources: [
      ...openFiles.map(f => ({
        uri:      \`file://\${path.join(openDir, f)}\`,
        name:     f.replace('.md', ''),
        mimeType: 'text/markdown',
      })),
      ...closedFiles.map(f => ({
        uri:      \`file://\${path.join(closedDir, f)}\`,
        name:     \`[closed] \${f.replace('.md', '')}\`,
        mimeType: 'text/markdown',
      })),
    ],
  };
});

server.setRequestHandler(ReadResourceRequestSchema, async (req) => {
  const filePath = new URL(req.params.uri).pathname;
  const content  = await fs.readFile(filePath, 'utf8');
  return { contents: [{ uri: req.params.uri, mimeType: 'text/markdown', text: content }] };
});

await server.connect(new StdioServerTransport());
`;

const mcpClientCode = `
// task-agent-client.ts — MCP client setup for the Task Manager Agent
// Two servers, two transports. The task-manager-server is custom (stdio).
// The filesystem server is the official @modelcontextprotocol/server-filesystem (stdio).
// Both use stdio → Roots is applicable to both.

import { Client }               from '@modelcontextprotocol/sdk/client/index.js';
import { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';
import { ListRootsRequestSchema } from '@modelcontextprotocol/sdk/types.js';

const PROJECT_ROOT = process.cwd();

// ── Client 1: custom task-manager-server ─────────────────────────────────────
const taskClient = new Client(
  { name: 'task-manager-agent', version: '1.0.0' },
  {
    capabilities: {
      roots: { listChanged: false },
      // Roots IS declared here because:
      //   1. This is a stdio server (local process, not HTTP+SSE)
      //   2. The server reads and writes files — it needs to know which paths are in scope
      // Contrast with EX1 (sales-tools-server): HTTP+SSE, no filesystem access → Roots not applicable.

      // sampling NOT declared — triage classification is handled in the agent graph (Haiku node),
      // not delegated to the server. See the "Sampling decision" section below.
    },
  }
);

// Scope the task-manager-server to the project root only
taskClient.setRequestHandler(ListRootsRequestSchema, async () => ({
  roots: [{ uri: \`file://\${PROJECT_ROOT}\`, name: 'Project root' }],
}));

const taskTransport = new StdioClientTransport({
  command: 'npx',
  args: ['tsx', 'task-manager-server.ts'],
  env: { ...process.env, PROJECT_ROOT },
});
await taskClient.connect(taskTransport);

// ── Client 2: official filesystem server (read-only repository access) ────────
const fsClient = new Client(
  { name: 'task-manager-agent-fs', version: '1.0.0' },
  {
    capabilities: {
      roots: { listChanged: false },
      // Roots also applicable: same reason — stdio + filesystem access
    },
  }
);

// Scope the filesystem server to the project root only
// Without this, the server could read any file on the machine
fsClient.setRequestHandler(ListRootsRequestSchema, async () => ({
  roots: [{ uri: \`file://\${PROJECT_ROOT}\`, name: 'Project root' }],
}));

const fsTransport = new StdioClientTransport({
  command: 'npx',
  args: ['@modelcontextprotocol/server-filesystem', PROJECT_ROOT],
});
await fsClient.connect(fsTransport);

export { taskClient, fsClient };
`;

const stateCode = `
import { Annotation, messagesStateReducer } from '@langchain/langgraph';
import { BaseMessage } from '@langchain/core/messages';

interface TaskFrontmatter {
  id:              string;
  title:           string;
  status:          'open' | 'in-progress' | 'blocked' | 'closed';
  priority:        'critical' | 'high' | 'medium' | 'low';
  tags:            string[];
  assignee?:       string;
  estimated_hours?: number;
  linked_files?:   string[];
  created:         string;
  updated:         string;
}

interface Task extends TaskFrontmatter {
  body: string;   // markdown body (description + acceptance criteria + notes)
}

// The filesystem is the source of truth. State holds an in-session cache —
// loaded once at the start of each interaction, not persisted by LangGraph.
// This means: if a task is modified outside the agent session (e.g. a teammate
// edits a file directly), state.taskCache is stale until the next load.
// See Phase 09 for the stale cache handling strategy.
export const TaskManagerState = Annotation.Root({
  messages:      Annotation<BaseMessage[]>({ reducer: messagesStateReducer }),
  projectRoot:   Annotation<string>(),
  inputMode:     Annotation<'interactive' | 'external-task'>({ default: () => 'interactive' }),
  externalInput: Annotation<string | null>({ default: () => null }),

  // In-session task cache — frontmatter only; body loaded on demand via get_task
  taskCache:     Annotation<TaskFrontmatter[]>({ default: () => [] }),
  cacheLoadedAt: Annotation<string | null>({ default: () => null }),

  // Task currently in focus for a multi-turn interaction
  activeTask:    Annotation<Task | null>({ default: () => null }),

  // Pending write awaiting interrupt() confirmation
  // Contains the full task that will be written or the change diff
  pendingWrite:  Annotation<{ action: 'create' | 'close'; payload: unknown } | null>({
                   default: () => null }),

  // Output of report generation
  report:        Annotation<string | null>({ default: () => null }),
});
`;

const triagePromptCode = `
// Triage node — Haiku, no tools
// Fired ONLY when inputMode === 'external-task' (piping in a bug report, GitHub issue, etc.)
// Extracts structured frontmatter fields from unstructured text.
// Does NOT write to disk — that happens in the Task Manager node after interrupt().

export const TRIAGE_PROMPT = \`
You are a task triage assistant. Given unstructured input (a bug report, GitHub issue, or feature request), extract structured task metadata.

Return JSON only. Do not add any task to the system yourself.
{
  "title":           "<concise action-oriented title — start with a verb>",
  "description":     "<one paragraph summary of the problem or feature>",
  "priority":        "critical | high | medium | low",
  "tags":            ["<tag1>", "<tag2>"],
  "estimated_hours": <number or null if unclear>
}

Priority rules:
- critical  — data loss, security vulnerability, complete feature outage
- high      — degraded functionality, no workaround available
- medium    — degraded functionality with a workaround, or new feature with a deadline
- low       — nice-to-have, cosmetic, no timeline pressure

Tags should be lowercase, single-word or hyphenated: "auth", "performance", "ui", "api", etc.
Extract as many relevant tags as the input supports — 2 to 5 is typical.
\`;
`;

const taskManagerPromptCode = `
// Task Manager node — Sonnet, 6 tools
// Handles all interactive requests and the final write step after triage.

export const TASK_MANAGER_PROMPT = \`
You are a task manager for a TypeScript software project. You read and write task files
stored as markdown under .tasks/open/ and .tasks/closed/ in the project repository.

## Tool usage rules
- list_tasks first for broad questions ("what's high priority?", "what am I assigned to?")
- get_task when you need the full description or acceptance criteria for a specific task
- search_tasks for semantic questions ("anything related to the auth refactor?")
- create_task when the user explicitly asks to create a new task
- update_task for status changes, priority changes, or adding linked files
- close_task ONLY after the user confirms — always show the task title and ask before closing

## Before calling close_task
Always confirm: "Close T-XXXX: <title>? This moves the file to .tasks/closed/ and cannot be undone."
Do not call close_task until the user says yes.

## Standup report format
When asked for a standup report, call list_tasks with status=in-progress and list_tasks with
status=open + priority=high. Then generate:
- Done (since last standup): tasks closed in the last 24 hours
- In progress: tasks currently in-progress
- Up next: top 3 open tasks by priority
- Blockers: tasks with status=blocked

## Linking tasks to code
When a user mentions a file path, call update_task to add it to linked_files.
When a user starts working on a task, call update_task to set status=in-progress and assignee.

## What you do NOT do
- Do not create tasks without being asked
- Do not close tasks without explicit confirmation
- Do not read source files unless the user specifically asks you to look at code
\`;
`;

