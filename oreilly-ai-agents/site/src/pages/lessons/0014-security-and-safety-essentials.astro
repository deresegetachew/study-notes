    background: #fff8f8;
    border: 1px solid #fca5a5;
    border-left: 4px solid #dc2626;
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin: 1rem 0;
  }
  .attack-label {
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: #dc2626;
    margin-bottom: .6rem;
  }
  .attack-pre {
    font-family: monospace;
    font-size: .8rem;
    background: #fee2e2;
    border-radius: 4px;
    padding: .75rem 1rem;
    white-space: pre-wrap;
    margin: .5rem 0;
    color: #7f1d1d;
  }
