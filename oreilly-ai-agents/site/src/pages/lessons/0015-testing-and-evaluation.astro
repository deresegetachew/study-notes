    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 1.5rem 0;
  }
  .test-layer {
    padding: 0.6rem 1rem;
    border-radius: 4px;
    font-size: 0.85rem;
    text-align: center;
  }
  .test-l-unit { background: #dbeafe; color: #1e3a8a; border: 1px solid #93c5fd; }
  .test-l-int  { background: #ede9fe; color: #4c1d95; border: 1px solid #c4b5fd; }
  .test-l-eval { background: #dcfce7; color: #14532d; border: 1px solid #86efac; }

