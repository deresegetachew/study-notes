@Controller('support')
export class SupportController {
  constructor(private readonly supervisor: SupervisorService) {}

  @Post('chat')
  chat(@Body() dto: ChatRequestDto) {
    return this.supervisor.chat(dto.message, dto.threadId);
  }
}
    `} />

