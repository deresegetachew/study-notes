import LessonHeader    from '@/components/LessonHeader.astro';
import LessonDiagram   from '@/components/LessonDiagram.astro';
import CodeBlock       from '@/components/CodeBlock.astro';
import LessonCallout   from '@/components/LessonCallout.astro';
import LessonChecklist from '@/components/LessonChecklist.astro';
import LessonMindMap   from '@/components/LessonMindMap.astro';

const supportMcpServerCode = `
// support-tools-server.ts
import { Server }             from '@modelcontextprotocol/sdk/server/index.js';
import { SSEServerTransport } from '@modelcontextprotocol/sdk/server/sse.js';
import {
  ListToolsRequestSchema,     CallToolRequestSchema,
  ListResourcesRequestSchema, ReadResourceRequestSchema,
  ListPromptsRequestSchema,   GetPromptRequestSchema,
} from '@modelcontextprotocol/sdk/types.js';

const server = new Server(
  { name: 'support-tools-server', version: '1.0.0' },
  { capabilities: { tools: {}, resources: {}, prompts: {} } },
);

// ── TOOLS — per-call, params from the live conversation ──────────────────────
server.setRequestHandler(ListToolsRequestSchema, async () => ({
  tools: [
    {
      name: 'search_docs',
      description:
        'Hybrid semantic + keyword search over HelixDB product documentation. ' +
        'Extract the core technical concept or exact error code before calling — ' +
        'do NOT pass the user\\'s raw sentence. Filter by version when known.',
      inputSchema: {
        type: 'object',
        properties: {
          query:   { type: 'string', description: 'Technical concept or exact error code' },
          version: { type: 'string', description: 'Semver string — filter to docs valid for this version' },
          top_k:   { type: 'number', default: 5 },
        },
        required: ['query'],
      },
    },
    {
      name: 'search_known_issues',
      description:
        'Semantic search over known bugs and service disruptions. Use when the user ' +
        'reports unexpected behaviour, an error code, or degraded performance.',
      inputSchema: {
        type: 'object',
        properties: {
          query:     { type: 'string', description: 'Error description or observed behaviour' },
          component: { type: 'string', description: 'Optional — narrow to a product component (ingestion / query-engine / storage / sdk)' },
        },
        required: ['query'],
      },
    },
    {
      name: 'get_changelog',
      description: 'Fetch breaking changes and new features between two product versions. Pass exact semver strings.',
      inputSchema: {
        type: 'object',
        properties: {
          from_version: { type: 'string' },
          to_version:   { type: 'string' },
        },
        required: ['from_version', 'to_version'],
      },
    },
    {
      name: 'get_ticket_status',
      description: 'Fetch current status and resolution notes for an existing support ticket by ID.',
      inputSchema: {
        type: 'object',
        properties: { ticket_id: { type: 'string' } },
        required: ['ticket_id'],
      },
    },
    {
      name: 'create_support_ticket',
      description:
        'Create a support ticket when docs do not answer the question, or the user reports ' +
        'data loss or a production outage. Populate steps_to_reproduce from the conversation.',
      inputSchema: {
        type: 'object',
        properties: {
          summary:            { type: 'string', description: 'One-sentence description of the issue' },
          severity:           { type: 'string', enum: ['low', 'medium', 'high', 'critical'] },
          steps_to_reproduce: { type: 'string' },
          product_version:    { type: 'string' },
        },
        required: ['summary', 'severity'],
      },
    },
  ],
}));

// ── RESOURCES — feed the offline vector-indexing pipeline only ────────────────
// These are NOT for runtime retrieval. The agent calls search_docs and
// search_known_issues at runtime — it never reads these Resources directly.
server.setRequestHandler(ListResourcesRequestSchema, async () => ({
  resources: [
    {
      uri: 'docs://helixdb/all',
      name: 'HelixDB documentation corpus',
      description:
        'Full doc set (getting-started, API reference, config guide, perf tuning, ' +
        'migration guides). Consumed by the offline nightly indexing pipeline ' +
        'that builds the vector store. NOT for runtime agent retrieval.',
      mimeType: 'application/json',
    },
    {
      uri: 'known-issues://helixdb/active',
      name: 'Active known issues',
      description:
        'All open known issues with workarounds, severity, affected versions. ' +
        'Consumed by the offline known-issues vector indexing pipeline. ' +
        'NOT for runtime agent retrieval.',
      mimeType: 'application/json',
    },
  ],
}));

// ── PROMPT TEMPLATES — shared task wording ───────────────────────────────────
server.setRequestHandler(ListPromptsRequestSchema, async () => ({
  prompts: [
    {
      name: 'citation-format',
      description: 'Standard citation format for any agent answering from the HelixDB knowledge base',
      arguments: [
        { name: 'claim',   required: true, description: 'The sentence being cited' },
        { name: 'doc_url', required: true },
        { name: 'section', required: true },
      ],
    },
    {
      name: 'ticket-created-reply',
      description: 'Standard message sent to a developer when a ticket is created on their behalf',
      arguments: [
        { name: 'ticket_id', required: true },
        { name: 'severity',  required: true },
        { name: 'summary',   required: true },
      ],
    },
  ],
}));

server.setRequestHandler(GetPromptRequestSchema, async (req) => {
  const { name, arguments: args = {} } = req.params;
  if (name === 'citation-format') {
    return {
      messages: [{
        role: 'user',
        content: { type: 'text', text: \`\${args.claim} [Source: \${args.doc_url}, §\${args.section}]\` },
      }],
    };
  }
  if (name === 'ticket-created-reply') {
    return {
      messages: [{
        role: 'user',
        content: { type: 'text', text:
          \`I've opened support ticket \${args.ticket_id} (severity: \${args.severity}) for: "\${args.summary}". \" +
          "The team will follow up via email. You can track progress at support.helixdb.io/tickets/\${args.ticket_id}.\`
        },
      }],
    };
  }
  throw new Error(\`Unknown prompt: \${name}\`);
});

const transport = new SSEServerTransport('/sse', res);
await server.connect(transport);
`;

const stateCode = `
import { Annotation, messagesStateReducer } from '@langchain/langgraph';
import { BaseMessage } from '@langchain/core/messages';

interface UserContext {
  userId:         string;
  productVersion: string;          // e.g. "2.4.1" — used to filter docs and flag version mismatches
  supportPlan:    'free' | 'pro' | 'enterprise';
  openTickets:    string[];         // existing ticket IDs — avoid creating duplicates
}

interface RetrievedChunk {
  chunkId:    string;
  source:     string;              // doc URL or known-issue ID
  section:    string;              // heading within the document
  content:    string;
  score:      number;              // cosine similarity (0–1)
  docVersion: string | null;       // product version the doc applies to
  updatedAt:  string;              // ISO date — detect stale docs (warn if > 90 days)
}

// Citations are state, not just text in the answer.
// They must persist across turns so the citation verifier (Phase 09) can
// cross-check every claim against the chunks that were actually retrieved.
interface Citation {
  claim:   string;  // the sentence in the answer using this source
  source:  string;  // URL
  section: string;  // heading
}

export const SupportState = Annotation.Root({
  messages:        Annotation<BaseMessage[]>({ reducer: messagesStateReducer }),
  userId:          Annotation<string>(),
  userContext:     Annotation<UserContext | null>({ default: () => null }),
  currentQuestion: Annotation<string>(),
  intent: Annotation<
    'documentation' | 'known-issue' | 'version-query' | 'escalate' | null
  >({ default: () => null }),
  retrievedChunks: Annotation<RetrievedChunk[]>({ default: () => [] }),
  citations:       Annotation<Citation[]>({ default: () => [] }),
  answer:          Annotation<string | null>({ default: () => null }),
  confidence:      Annotation<'high' | 'low' | null>({ default: () => null }),
  ticketId:        Annotation<string | null>({ default: () => null }),
});
`;

const searchDocsCode = `
// search_docs implementation inside support-tools-server.ts
// Hybrid search: semantic (embeddings) + keyword (full-text index).
// Why hybrid? Error codes like "ERR_SCHEMA_CONFLICT" won't embed well —
// vector search ranks by meaning; BM25 ranks by exact string match.
// Combining both covers both semantics and exact terminology.

import { OpenAIEmbeddings } from '@langchain/openai';
import { z }                from 'zod';

const embeddings = new OpenAIEmbeddings({ model: 'text-embedding-3-small' });

async function handleSearchDocs(args: unknown) {
  const { query, version, top_k = 5 } = SearchDocsSchema.parse(args);

  // 1. Embed the extracted concept (not the user's raw sentence — agent does that)
  const queryVector = await embeddings.embedQuery(query);

  // 2. Run both searches in parallel — they are independent
  const [semanticResults, keywordResults] = await Promise.all([
    vectorStore.similaritySearchWithScore(queryVector, top_k * 2, {
      filter: version ? { docVersion: { $lte: version } } : undefined,
    }),
    fullTextIndex.search(query, {
      limit:  top_k,
      filter: version ? { docVersion: version } : undefined,
    }),
  ]);

  // 3. Reciprocal Rank Fusion — merges two ranked lists without needing score normalisation
  const merged = reciprocalRankFusion(
    semanticResults.map(r => r[0]),  // discard scores; RRF uses rank position
    keywordResults,
    { k: 60 },                        // standard RRF constant
  );

  return merged.slice(0, top_k).map(chunk => ({
    chunkId:    chunk.id,
    source:     chunk.metadata.url,
    section:    chunk.metadata.heading,
    content:    chunk.pageContent,
    score:      chunk.rrf_score,
    docVersion: chunk.metadata.docVersion ?? null,
    updatedAt:  chunk.metadata.updatedAt,
  }));
}
`;

const classifierPromptCode = `
// Classifier node — Haiku, no tools
// Fast, cheap intent routing. Does not answer the question.
// One job: return the intent as structured JSON.

export const CLASSIFIER_PROMPT = \`
You are an intent classifier for HelixDB Cloud technical support.

Given the developer's question and conversation history, classify intent into exactly one:

- documentation   — how-to questions, API usage, configuration, feature questions, tutorials
- known-issue     — error codes, unexpected behaviour, performance degradation, suspected bugs
- version-query   — questions about what changed between versions, breaking changes, migration
- escalate        — account/billing, SLA enforcement, data loss, security incident, explicit request for human

Return JSON only. Do not answer the question. Do not guess at a solution.
{ "intent": "<category>", "reason": "<one sentence>" }

Classification rules:
- Mention of a specific error code or "not working" → prefer known-issue over documentation.
- Uncertain between documentation and known-issue → prefer known-issue (more thorough retrieval).
- Uncertain whether to escalate → prefer documentation; the Resolver will escalate if docs don't answer.
- Data loss or production outage keywords → always escalate, regardless of other signals.
\`;
`;

const resolverPromptCode = `
// Resolver node — Sonnet, 5 tools
// Core agent: retrieves docs and known issues, generates a cited answer,
// creates a ticket if docs don't answer.

export const RESOLVER_PROMPT = \`
You are a technical support specialist for HelixDB Cloud.
Answer developer questions using ONLY the retrieved documentation chunks in your context.

## Citation rule — mandatory, no exceptions
Every factual claim must be followed by a citation: [Source: <url>, §<section>]
If a claim is not present in any retrieved chunk, do NOT state it — even if you know it from training.

## If the retrieved context does not contain the answer
Say: "I don't have documentation for this specific case."
Then call create_support_ticket() with a clear summary and severity.
Never fabricate. Never answer from training knowledge if the answer isn't in the retrieved chunks.

## Answer format
1. Direct answer with inline citations on every factual claim
2. Code example if applicable (cite the source)
3. Relevant next steps from retrieved chunks (with links)
4. If a known issue: state issue ID, severity, workaround status, and estimated fix version — all cited

## Tool usage sequence
For documentation questions:     call search_docs first. If inconclusive, call search_known_issues.
For known-issue questions:       call search_known_issues first. Then search_docs for the workaround.
For version-query questions:     call get_changelog(from_version, to_version).
Always filter search_docs by the user's product version when it is known.

## Version awareness
userContext.productVersion tells you what the user is running.
If retrieved docs apply to a different version: "This applies to v2.5. You are on v2.3 — verify availability."
If any retrieved chunk has updatedAt older than 90 days: add "⚠ This doc was last updated [date]. Verify it still applies."

## When to call create_support_ticket
- Both search_docs and search_known_issues return no relevant chunks
- User mentions data loss, data corruption, or a production outage
- User explicitly requests to speak with a human or open a ticket
After creating a ticket, tell the user the ticket ID and expected response time based on their support plan.
\`;
`;

const mindMap = `
# Tech Support RAG Exercise
## Three Knowledge Sources
### Docs (RAG Tool — hybrid search)
### Known issues (RAG Tool — semantic)
### Changelog (DB Tool — exact lookup)
## Hybrid Search Design
### Semantic + BM25 in parallel
