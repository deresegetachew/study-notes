import LessonHeader    from '@/components/LessonHeader.astro';
import LessonDiagram   from '@/components/LessonDiagram.astro';
import CodeBlock       from '@/components/CodeBlock.astro';
import LessonCallout   from '@/components/LessonCallout.astro';
import LessonChecklist from '@/components/LessonChecklist.astro';
import LessonMindMap   from '@/components/LessonMindMap.astro';

const salesMcpServerCode = `
// sales-tools-server.ts
// Built at Phase 04 — the moment Chat Specialist and Email Specialist both need
// check_inventory and get_order_status. Define the server first; both agents connect
// to it rather than each inlining duplicate tool code.
import { Server }              from '@modelcontextprotocol/sdk/server/index.js';
import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
import {
  ListToolsRequestSchema,     CallToolRequestSchema,
  ListResourcesRequestSchema, ReadResourceRequestSchema,
  ListPromptsRequestSchema,   GetPromptRequestSchema,
} from '@modelcontextprotocol/sdk/types.js';
import { z } from 'zod';

const server = new Server(
  { name: 'sales-tools-server', version: '1.0.0' },
  { capabilities: { tools: {}, resources: {}, prompts: {} } },
);

// ── TOOLS — per-call actions whose params come from the live conversation ──────
const CheckInventorySchema = z.object({ sku: z.string(), qty: z.number().int().positive().optional() });
const GetOrderStatusSchema  = z.object({ order_id: z.string() });
const SearchCatalogSchema   = z.object({ query: z.string().min(1) });

server.setRequestHandler(ListToolsRequestSchema, async () => ({
  tools: [
    {
      name:        'check_inventory',
      description: 'Return available stock for a SKU. Pass qty to check if a requested amount is available.',
      inputSchema: { type: 'object', properties: { sku: { type: 'string' }, qty: { type: 'number' } }, required: ['sku'] },
    },
    {
      name:        'get_order_status',
      description: 'Fetch current status, line items, and timestamps for an order.',
      inputSchema: { type: 'object', properties: { order_id: { type: 'string' } }, required: ['order_id'] },
    },
    {
      name:        'search_product_catalog',
      description: 'Full-text search the product catalog. Returns up to 10 matching products.',
      inputSchema: { type: 'object', properties: { query: { type: 'string' } }, required: ['query'] },
    },
  ],
}));

server.setRequestHandler(CallToolRequestSchema, async (req) => {
  const { name, arguments: args = {} } = req.params;
  try {
    if (name === 'check_inventory') {
      const { sku, qty } = CheckInventorySchema.parse(args);
      const stock = await inventory.check(sku);
      return { content: [{ type: 'text', text: JSON.stringify({ sku, requested: qty ?? null, available: stock }) }] };
    }
    if (name === 'get_order_status') {
      const { order_id } = GetOrderStatusSchema.parse(args);
      return { content: [{ type: 'text', text: JSON.stringify(await orders.get(order_id)) }] };
    }
    if (name === 'search_product_catalog') {
      const { query } = SearchCatalogSchema.parse(args);
      return { content: [{ type: 'text', text: JSON.stringify(await catalog.search(query, { limit: 10 })) }] };
    }
    return { content: [{ type: 'text', text: \`Unknown tool: \${name}\` }], isError: true };
  } catch (err) {
    return { content: [{ type: 'text', text: \`Error: \${String(err)}\` }], isError: true };
  }
});

// ── RESOURCES — reference data refreshed on a schedule, same content every call ─
server.setRequestHandler(ListResourcesRequestSchema, async () => ({
  resources: [
    { uri: 'product://catalog',       name: 'Product catalog',   description: 'All active products. Refreshed nightly.',     mimeType: 'application/json' },
    { uri: 'config://pricing-rules',  name: 'Pricing rules',     description: 'Discount tiers and minimum order quantity.',   mimeType: 'application/json' },
    { uri: 'config://shipping-zones', name: 'Shipping zone map', description: 'Zone to carrier to lead-time mapping.',        mimeType: 'application/json' },
  ],
}));

server.setRequestHandler(ReadResourceRequestSchema, async (req) => {
  const { uri } = req.params;
  if (uri === 'product://catalog')
    return { contents: [{ uri, mimeType: 'application/json', text: JSON.stringify(await catalog.getAll({ limit: 500 })) }] };
  if (uri === 'config://pricing-rules')
    return { contents: [{ uri, mimeType: 'application/json', text: JSON.stringify(PRICING_RULES) }] };
  if (uri === 'config://shipping-zones')
    return { contents: [{ uri, mimeType: 'application/json', text: JSON.stringify(SHIPPING_ZONES) }] };
  throw new Error(\`Resource not found: \${uri}\`);
});

// ── PROMPT TEMPLATES — shared across Chat Specialist and Email Specialist ──────
// Update the template once; behaviour changes in both agents without a code deploy.
server.setRequestHandler(ListPromptsRequestSchema, async () => ({
  prompts: [
    {
      name:      'order-confirmation',
      description: 'Customer-facing order confirmation. channel arg adapts length for chat vs email.',
      arguments: [
        { name: 'customer_name', required: true  }, { name: 'order_id', required: true  },
        { name: 'items',         required: true  }, { name: 'total',    required: true  },
        { name: 'channel',       required: false },
      ],
    },
    {
      name:      'low-stock-warning',
      description: 'Internal alert when a product falls below reorder threshold.',
      arguments: [{ name: 'product', required: true }, { name: 'qty', required: true }],
    },
  ],
}));

server.setRequestHandler(GetPromptRequestSchema, async (req) => {
  const { name, arguments: args = {} } = req.params;
  const a = args as Record<string, string>;

  if (name === 'order-confirmation') {
    const maxWords = a.channel === 'chat' ? '60' : '120';
    return {
      messages: [{ role: 'user', content: { type: 'text', text:
\`Write a professional order confirmation for \${a.customer_name}.
Order #\${a.order_id} — items: \${a.items} — total: $\${a.total}.
Warm and professional. Under \${maxWords} words. Include estimated delivery.\` } }],
    };
  }
  if (name === 'low-stock-warning') {
    return {
      messages: [{ role: 'user', content: { type: 'text', text:
\`Stock alert: \${a.product} has \${a.qty} units remaining.
Recommend reorder urgency (low / medium / high) and suggested quantity.\` } }],
    };
  }
  throw new Error(\`Unknown prompt: \${name}\`);
});

await server.connect(new StdioServerTransport());

declare const inventory: { check: (sku: string) => Promise<number> };
declare const orders:    { get:   (id: string)  => Promise<object> };
declare const catalog:   { search: (q: string, o: object) => Promise<object[]>; getAll: (o: object) => Promise<object[]> };
declare const PRICING_RULES:  object;
declare const SHIPPING_ZONES: object;
`.trim();

const stateCode = `
// Phase 5 — state schema
import { Annotation } from '@langchain/langgraph';

// One entry per discrete order operation found in an email or conversation turn
interface OrderOperation {
  id:             string;      // stable key for interrupt() checkpoint
  intent:         'cancel' | 'modify' | 'create_order' | 'status_check';
  orderId:        string | null;                    // null until confirmed
  currentState:   Record<string, unknown> | null;  // loaded by lookup node
  proposedChange: Record<string, unknown> | null;
  status: 'pending_lookup' | 'awaiting_approval' | 'approved' | 'rejected' | 'complete';
}

const SalesAgentState = Annotation.Root({
  // Channel & routing
  channel: Annotation<'chat' | 'email'>({ reducer: (_, b) => b }),

  // Conversation — always accumulates
  messages: Annotation<Array<{ role: string; content: string }>>({
    reducer: (a, b) => [...a, ...b],
    default: () => [],
  }),

  // Email context
  emailMessageId:   Annotation<string | null>({ reducer: (_, b) => b, default: () => null }),
  emailThreadId:    Annotation<string | null>({ reducer: (_, b) => b, default: () => null }),
  emailThreadSummary: Annotation<string | null>({ reducer: (_, b) => b, default: () => null }),
  alreadyProcessed: Annotation<boolean>({ reducer: (_, b) => b, default: () => false }),

  // Cross-thread context — when a new email references an order from a past thread
  crossThreadContext: Annotation<{
    lookupMethod:     'explicit_id' | 'recency_match' | 'semantic';
    candidateOrders:  Record<string, unknown>[];
    confirmedOrderId: string | null;
  } | null>({ reducer: (_, b) => b, default: () => null }),

  // Customer
  customerId: Annotation<string>({ reducer: (_, b) => b }),

  // Multi-operation support (replaces singular referencedOrder / pendingChanges)
  // Reducer: updates are merged by id; new operations are appended
  pendingOperations: Annotation<OrderOperation[]>({
    reducer: (existing, updates) => {
      const map = new Map(existing.map(op => [op.id, op]));
      for (const up of updates) map.set(up.id, { ...map.get(up.id), ...up });
      return Array.from(map.values());
    },
    default: () => [],
  }),

  // Which operation is currently at the interrupt() gate
  activeOperationId: Annotation<string | null>({ reducer: (_, b) => b, default: () => null }),

  // New quotes (chat channel, or quote requests via email)
  currentQuote: Annotation<Record<string, unknown> | null>({ reducer: (_, b) => b, default: () => null }),

  // Accumulators — always append, never overwrite
  stockWarnings: Annotation<string[]>({ reducer: (a, b) => [...a, ...b], default: () => [] }),
  actionsTaken:  Annotation<string[]>({ reducer: (a, b) => [...a, ...b], default: () => [] }),

  // Loop control
  turnCount:        Annotation<number>({ reducer: (_, b) => b, default: () => 0 }),
  awaitingApproval: Annotation<boolean>({ reducer: (_, b) => b, default: () => false }),
});
`.trim();

const decompositionCode = `
// Intent decomposition node — first step in the email pipeline
// Extracts ALL distinct order operations from a single email before any tool is called
async function decomposeEmailIntent(
  state: typeof SalesAgentState.State,
): Promise<Partial<typeof SalesAgentState.State>> {
  const response = await anthropic.messages.create({
    model: 'claude-haiku-4-5-20251001',    // cheap: classification only
    max_tokens: 1024,
    system: \`Extract all distinct order operations from this email.
Return a JSON array. Each element:
  { "intent": "cancel"|"modify"|"create_order"|"status_check",
    "orderId": "<id or null>",
    "proposedChange": { ...fields } | null }
Return ONLY the JSON array.\`,
    messages: [{ role: 'user', content: state.emailThreadSummary ?? '' }],
  });

  const raw = JSON.parse(
    (response.content[0] as { text: string }).text
  ) as Omit<OrderOperation, 'id' | 'status' | 'currentState'>[];

  const operations: OrderOperation[] = raw.map((op, i) => ({
    ...op,
    id:           \`op-\${Date.now()}-\${i}\`,
    currentState: null,
    status:       op.orderId ? 'pending_lookup' : 'awaiting_approval',
  }));

  return { pendingOperations: operations };
}

// Cross-thread lookup node — resolves orderId: null operations
async function resolveOrderIds(
  state: typeof SalesAgentState.State,
): Promise<Partial<typeof SalesAgentState.State>> {
  const unresolved = state.pendingOperations.filter(
    op => op.orderId === null && op.intent !== 'create_order',
  );
  if (unresolved.length === 0) return {};

  // Priority 1: explicit order number in the email body
  const match = state.emailThreadSummary?.match(/#?(ORD-\d+|\d{5,})/i);
  if (match) {
    const orderId = match[1];
    return {
      pendingOperations: unresolved.map(op => ({ ...op, orderId, status: 'pending_lookup' })),
    };
  }

  // Priority 2: recent orders for this customer — present list, ask customer to confirm
  // (agent node handles the clarification conversation; we surface the candidates here)
  return {
    crossThreadContext: {
      lookupMethod:     'recency_match',
      candidateOrders:  [],   // filled by get_recent_orders tool call in next node
      confirmedOrderId: null,
    },
  };
}
`.trim();

const decompositionPromptCode = `
// Decomposition node — cheap model (Haiku), structured extraction only
const DECOMPOSITION_PROMPT = \`
You are a structured data extractor.
Read the email thread and return every distinct customer intent as a JSON array.

Each item must have:
{
  "action": "check_availability" | "create_quote" | "create_order"
          | "modify_order" | "cancel_order" | "check_status",
  "productDescription": string | null,  // customer's exact words — do not normalise
  "orderId": string | null,             // null if no explicit ID present
  "quantity": number | null,
  "proposedChange": object | null       // modify_order only: what should change
}

Rules:
- One item per distinct intent — a single email may have several
- Set orderId to null when no explicit ID exists — the lookup node resolves it
- Return ONLY valid JSON. No explanation, no markdown.
\`;
`.trim();

const lookupPromptCode = `
// Lookup node — cheap model (Haiku), order reference reasoning
const LOOKUP_PROMPT = \`
You are an order reference resolver.

You receive:
- The full email thread
- pending_operations: operations where orderId may be null
- recentOrders: the customer's orders from the last 30 days

For each operation where orderId is null:
1. Extract all reference clues from the email — explicit IDs, product names,
   quantities, dates, amounts ("the order I placed last week for 50 units of X")
2. Match those clues against recentOrders
   - One order matches all clues confidently → assign it, record your reasoning
   - Multiple could match, or none match → leave orderId as null
3. Do not guess. A confident match means all clues point to the same order.

Return the updated operations array as JSON:
[{ ...operation, orderId: string | null, resolutionReason: string | null }]

The Email Specialist will ask the customer for any remaining nulls.
Return ONLY valid JSON.
\`;
`.trim();

const chatSpecialistPromptCode = `
// Chat Specialist — handles real-time chat channel
const CHAT_SPECIALIST_PROMPT = \`
You are the Chat Sales Specialist for XYZ Corp.
Resolve customer order queries in real time. Be concise — chat is synchronous.

Tools: check_inventory, get_order_status, search_product_catalog,
       lookup_customer, create_quote, create_order

## Product resolution
When a customer describes a product rather than naming it exactly:
1. Extract the key descriptor (colour, size, category, common name)
2. Call search_product_catalog(descriptor) — not the customer's raw sentence
3. One clear match → proceed. Multiple candidates → list them and ask.
   Never assume a match.

## Quote and order flow
1. Call check_inventory before quoting — warn if qty < 10
   "⚠ Only {qty} units of {product} remaining."
2. create_quote is automatic (reversible draft, no side effects)
3. create_order requires interrupt() — show the quote summary before confirming

## Hard rules
- Never call create_order without interrupt() approval
- Never assume a product match
- If intent is unclear: ask once, concisely
\`;
`.trim();

const emailSpecialistPromptCode = `
// Email Specialist — handles async email channel
const EMAIL_SPECIALIST_PROMPT = \`
You are the Email Sales Specialist for XYZ Corp.
Process customer order requests that arrived via email.
Reply professionally and completely — email is async, one reply should resolve everything.

Tools: get_order_status, check_inventory, search_product_catalog,
       modify_order, cancel_order, send_email

## What is already done when you receive control
- Duplicate check passed — this email has not been processed before
- pending_operations is populated with all customer intents (decomposition node)
- orderId is resolved where possible from email context (lookup node)
- Any operation with orderId: null could not be resolved — you must ask the customer

## Processing operations
Work through pending_operations sequentially:
1. For any null orderId: show candidates if available, otherwise ask for the order ID
2. For each resolved operation:
   call get_order_status(orderId)
   → build diff { current, proposed }
   → call interrupt() with the diff
   → wait for approval
   → on confirm: execute. On reject: record and move to next step.
3. Complete op[0] fully before starting op[1]
4. If op[0] is REJECTED: stop and ask how to proceed — do not auto-start op[1]

## Product resolution
Same rules as Chat Specialist — extract descriptor, call search_product_catalog,
confirm when multiple candidates, never assume.

## Hard rules
- Never call modify_order or cancel_order without interrupt() approval
- Never act on an inferred order reference without stating your reasoning in the reply
- Never process pending_operations out of order
\`;
`.trim();

const mcpClientCapabilitiesCode = `
// Phase 04 — MCP client capabilities declaration
// Connect once at graph init. Declare what the Sales Order Agent provides back.

import { Client }              from '@modelcontextprotocol/sdk/client/index.js';
import { SSEClientTransport }  from '@modelcontextprotocol/sdk/client/sse.js';

// HTTP+SSE transport — sales-tools-server is a deployed service, not a local process.
// Roots is not declared: it is a filesystem scope mechanism for stdio servers.
// sales-tools-server calls APIs and databases; it never touches the filesystem.
const transport = new SSEClientTransport(
  new URL('https://sales-tools.internal/sse')
);

const mcpClient = new Client(
  { name: 'sales-order-agent', version: '1.0.0' },
  {
    capabilities: {
      // sampling NOT declared — the server has no reason to initiate LLM calls
      // back into the agent. Omitting it makes the capability unavailable.
    },
  }
);

await mcpClient.connect(transport);
`.trim();

const mindMap = `
# Sales Order Agent Exercise
## Two Channels
### Chat Specialist (real-time)
### Email Specialist (async)
## MCP Server Design
### Tools (check_inventory, get_order_status, search_catalog)
### Resources (catalog, pricing-rules, shipping-zones)
