// ── Client: discovery ─────────────────────────────────────────────────────────
const mcpClientCode = `
import { Client }              from '@modelcontextprotocol/sdk/client/index.js';
import { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';
import Anthropic from '@anthropic-ai/sdk';

const transport = new StdioClientTransport({
  command: 'node',
  args:    ['./sales-tools-server.js'],
});
const mcpClient = new Client({ name: 'sales-agent', version: '1.0.0' }, { capabilities: {} });
await mcpClient.connect(transport);

// ── Discovery: ask the server what it offers ──────────────────────────────────
const { tools }     = await mcpClient.listTools();
const { resources } = await mcpClient.listResources();
const { prompts }   = await mcpClient.listPrompts();
console.log('Tools:',     tools.map(t => t.name));
// e.g. [ 'check_inventory', 'get_order_status', 'search_product_catalog' ]
console.log('Resources:', resources.map(r => r.uri));
// e.g. [ 'product://catalog', 'config://pricing-rules', 'config://shipping-zones' ]
console.log('Prompts:',   prompts.map(p => p.name));
// e.g. [ 'order-confirmation', 'low-stock-warning' ]

// ── Using Tools: convert schema then call the LLM ─────────────────────────────
const anthropicTools: Anthropic.Tool[] = tools.map(tool => ({
  name:         tool.name,
  description:  tool.description ?? '',
  input_schema: tool.inputSchema as Anthropic.Tool['input_schema'],
}));

const anthropic = new Anthropic();
const response  = await anthropic.messages.create({
  model: 'claude-opus-4-8', max_tokens: 1024, tools: anthropicTools,
  messages: [{ role: 'user', content: 'Do we have 50 units of SKU-123 in stock?' }],
});
for (const block of response.content) {
  if (block.type === 'tool_use') {
    const result = await mcpClient.callTool({
      name: block.name, arguments: block.input as Record<string, unknown>,
    });
    console.log(\`Tool \${block.name} returned:\`, result.content);
  }
}

// ── Using Resources: read reference data ──────────────────────────────────────
const catalog = await mcpClient.readResource({ uri: 'product://catalog' });
console.log('Catalog snippet:', catalog.contents[0].text?.slice(0, 200));

// ── Using Prompt Templates: get a parameterised messages array ────────────────
const confirmation = await mcpClient.getPrompt({
  name:      'order-confirmation',
  arguments: { customer_name: 'Alice', order_id: 'ORD-42', items: 'Widget x2', total: '49.99', channel: 'chat' },
});
// confirmation.messages is already in Anthropic message format — pass directly
const llmReply = await anthropic.messages.create({
  model: 'claude-haiku-4-5-20251001', max_tokens: 256,
  messages: confirmation.messages as Anthropic.MessageParam[],
});
console.log('Confirmation text:', llmReply.content[0]);

await mcpClient.close();
`.trim();

// ── Client: per-node tool filtering ──────────────────────────────────────────
const mcpPerNodeCode = `
import { Client }              from '@modelcontextprotocol/sdk/client/index.js';
import { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';
import Anthropic from '@anthropic-ai/sdk';

// ── Graph init — connect ONCE before graph.compile() ─────────────────────────
const mcpClient = new Client({ name: 'sales-agent', version: '1.0.0' }, { capabilities: {} });
await mcpClient.connect(new StdioClientTransport({ command: 'node', args: ['./sales-tools-server.js'] }));

const { tools } = await mcpClient.listTools();   // discover ONCE
const allTools  = tools.map(t => ({              // convert ONCE, cache for the graph lifetime
  name:         t.name,
  description:  t.description ?? '',
  input_schema: t.inputSchema as Anthropic.Tool['input_schema'],
}));

const anthropic = new Anthropic();

// ── searchNode — sees 2 of the server's tools ─────────────────────────────────
async function searchNode(state: AgentState) {
  const nodeTools = allTools.filter(t =>
    ['check_inventory', 'search_product_catalog'].includes(t.name),
  );
  // LLM context: 2 tool descriptions — focused, cheap, unambiguous
  return anthropic.messages.create({
    model: 'claude-haiku-4-5-20251001', max_tokens: 512,
    tools: nodeTools,
    messages: state.messages,
  });
}

// ── orderNode — sees 1 tool ───────────────────────────────────────────────────
async function orderNode(state: AgentState) {
  const nodeTools = allTools.filter(t => t.name === 'get_order_status');
  return anthropic.messages.create({
    model: 'claude-opus-4-8', max_tokens: 1024,
    tools: nodeTools,
    messages: state.messages,
  });
}

// ── Tool execution — shared client, both nodes call through it ────────────────
async function executeTool(name: string, args: Record<string, unknown>) {
  const result = await mcpClient.callTool({ name, arguments: args });
  return result.content;
}

declare interface AgentState { messages: Anthropic.MessageParam[] }
`.trim();

// ── Client: Roots — 4 configurations ─────────────────────────────────────────
const mcpRootsCode = `
import { Client }              from '@modelcontextprotocol/sdk/client/index.js';
import { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';
import { ListRootsRequestSchema } from '@modelcontextprotocol/sdk/types.js';

// ─── Configuration A: single path ─────────────────────────────────────────────
// Most common. One project folder; the server must stay inside it.
const mcpClient = new Client(
  { name: 'code-agent', version: '1.0.0' },
  { capabilities: { roots: { listChanged: false } } },
);
mcpClient.setRequestHandler(ListRootsRequestSchema, async () => ({
  roots: [{ uri: 'file:///workspace/src', name: 'Source code' }],
}));

// ─── Configuration B: multiple paths (monorepo / multi-service) ───────────────
// Grant access to several directories. Everything outside these URIs is off-limits.
mcpClient.setRequestHandler(ListRootsRequestSchema, async () => ({
  roots: [
    { uri: 'file:///workspace/packages/api/src',    name: 'API service'      },
    { uri: 'file:///workspace/packages/worker/src', name: 'Worker service'   },
    { uri: 'file:///workspace/shared/src',          name: 'Shared utilities' },
    { uri: 'file:///workspace/docs',                name: 'Documentation'    },
  ],
}));

// ─── Configuration C: dynamic roots ───────────────────────────────────────────
// Accessible paths are not fixed at build time — read from config or chosen by user.
// listChanged: true tells the server to re-call listRoots() when the set changes.
const mcpClientDynamic = new Client(
  { name: 'code-agent', version: '1.0.0' },
  { capabilities: { roots: { listChanged: true } } },
);

const projectConfig = await loadProjectConfig(); // reads project.json or equivalent
let currentRoots = projectConfig.sourcePaths.map(p => ({
  uri:  \`file://\${p.absPath}\`,
  name: p.label,
}));

mcpClientDynamic.setRequestHandler(ListRootsRequestSchema, async () => ({
  roots: currentRoots,
}));

// When the user opens a new folder mid-session, update and notify the server:
async function onUserAddsFolder(absPath: string, label: string) {
  currentRoots.push({ uri: \`file://\${absPath}\`, name: label });
  await mcpClientDynamic.sendRootsListChanged(); // server re-calls listRoots() immediately
}

// ─── Configuration D: no roots (block all filesystem access) ─────────────────
// When you want to explicitly prevent a server from touching the filesystem.
// Register a handler that returns an empty list — a well-behaved server respects it.
// If you skip both the capability declaration AND the handler, a filesystem server
// may attempt to access arbitrary paths with no sandbox enforcement.
const mcpClientNoAccess = new Client(
  { name: 'restricted-agent', version: '1.0.0' },
  { capabilities: { roots: { listChanged: false } } },
);
mcpClientNoAccess.setRequestHandler(ListRootsRequestSchema, async () => ({
  roots: [],  // empty list = server allowed to access nothing on the filesystem
}));

declare function loadProjectConfig(): Promise<{ sourcePaths: { absPath: string; label: string }[] }>;
`.trim();

// ── Client: Sampling — 4 scenarios ───────────────────────────────────────────
const mcpSamplingCode = `
import { Client }              from '@modelcontextprotocol/sdk/client/index.js';
import { CreateMessageRequestSchema, McpError, ErrorCode } from '@modelcontextprotocol/sdk/types.js';
import Anthropic from '@anthropic-ai/sdk';

const anthropic = new Anthropic();

// ─── Scenario A: simple accept — fulfil, but choose your own model ─────────────
// The server may suggest a model via req.params.modelPreferences. Ignore it.
// The client always picks the model and caps the token budget.
mcpClient.setRequestHandler(CreateMessageRequestSchema, async (req) => {
  const response = await anthropic.messages.create({
    model:      'claude-haiku-4-5-20251001',                   // YOUR choice — not the server's
    max_tokens: Math.min(req.params.maxTokens ?? 512, 512),    // your cap regardless of request
    system:     req.params.systemPrompt,
    messages:   req.params.messages as Anthropic.MessageParam[],
  });
  return {
    model:      response.model,
    role:       'assistant' as const,
    content:    response.content[0],
    stopReason: 'endTurn',
  };
});

// ─── Scenario B: rate-limited — reject above N calls per session ───────────────
// Prevents a misbehaving server from triggering unlimited (and expensive) inference.
const callCount = new Map<string, number>(); // sessionId → count

mcpClient.setRequestHandler(CreateMessageRequestSchema, async (req) => {
  const sessionId = 'session-1';           // derive from your transport session in practice
  const count     = callCount.get(sessionId) ?? 0;

  if (count >= 10) {
    throw new McpError(ErrorCode.InvalidRequest, 'Sampling rate limit (10/session) exceeded');
  }
  callCount.set(sessionId, count + 1);

  const response = await anthropic.messages.create({
    model: 'claude-haiku-4-5-20251001', max_tokens: 512,
    messages: req.params.messages as Anthropic.MessageParam[],
  });
  return { model: response.model, role: 'assistant' as const, content: response.content[0], stopReason: 'endTurn' };
});

// ─── Scenario C: content-validated — inspect before forwarding ─────────────────
// Guards against prompt injection hidden inside the server's sampling request.
mcpClient.setRequestHandler(CreateMessageRequestSchema, async (req) => {
  const lastMsg = req.params.messages.at(-1);
  const text    = typeof lastMsg?.content === 'string'
    ? lastMsg.content
    : (lastMsg?.content as Array<{ type: string; text?: string }>)?.[0]?.text ?? '';

  // Basic injection heuristic — extend with your real detection logic from L13
  if (/ignore.{0,20}instructions|system.{0,10}prompt|override/i.test(text)) {
    throw new McpError(ErrorCode.InvalidRequest, 'Sampling rejected: injection pattern detected');
  }

  const response = await anthropic.messages.create({
    model: 'claude-haiku-4-5-20251001', max_tokens: 512,
    messages: req.params.messages as Anthropic.MessageParam[],
  });
  return { model: response.model, role: 'assistant' as const, content: response.content[0], stopReason: 'endTurn' };
});

// ─── Scenario D: full rejection — never fulfil for this server ────────────────
// Use for untrusted community servers, or any server that should never need LLM access.
// You may have registered sampling for other clients — reject this one explicitly.
mcpClient.setRequestHandler(CreateMessageRequestSchema, async () => {
  throw new McpError(ErrorCode.MethodNotFound, 'This client does not permit server-initiated LLM inference');
});

declare const mcpClient: Client;
`.trim();

