// ── Direct vs MCP comparison ──────────────────────────────────────────────────
const directVsMcpCode = `
// ── Direct tool calling (no MCP) ─────────────────────────────────────────────
// The tool is defined INSIDE the agent codebase. Tightly coupled.
import { tool } from '@langchain/core/tools';
import { z }    from 'zod';

const checkInventory = tool(
  async ({ sku }: { sku: string }) => {
    const stock = await db.query('SELECT stock FROM products WHERE sku = ?', [sku]);
    return JSON.stringify({ sku, available: stock });
  },
  {
    name:        'check_inventory',
    description: 'Check available stock for a SKU.',
    schema:      z.object({ sku: z.string() }),
  },
);
// Second agent needs this tool?  Copy-paste, or create a shared import.
// Python agent wants to call it? Impossible — different runtime.
// Claude Desktop wants to use it? No standard interface to plug into.
// Change the implementation?      Redeploy the whole agent.

// ── MCP tool calling ─────────────────────────────────────────────────────────
// The tool lives in a SEPARATE server process. Any MCP client can discover it.
import { Client }              from '@modelcontextprotocol/sdk/client/index.js';
import { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';

const transport = new StdioClientTransport({ command: 'node', args: ['./sales-tools-server.js'] });
const mcpClient = new Client({ name: 'chat-specialist', version: '1.0.0' }, { capabilities: {} });
await mcpClient.connect(transport);

const { tools } = await mcpClient.listTools();  // discovers check_inventory at runtime
// Chat Specialist, Email Specialist, Claude Desktop — all connect to the same server.
// Change the implementation?  Redeploy the server only — agents are unchanged.
// Python agent?               Same MCP protocol — works from any language.
`.trim();

// ── Server: Tool primitive ────────────────────────────────────────────────────
const mcpToolServerCode = `
import { Server }              from '@modelcontextprotocol/sdk/server/index.js';
import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
import { ListToolsRequestSchema, CallToolRequestSchema } from '@modelcontextprotocol/sdk/types.js';
import { z } from 'zod';

const server = new Server(
  { name: 'weather-server', version: '1.0.0' },
  { capabilities: { tools: {} } },
);

// Zod schema validates LLM-provided args before any business logic runs
const GetWeatherSchema = z.object({
  city:  z.string().min(1).describe('City name'),
  units: z.enum(['celsius', 'fahrenheit']).default('celsius'),
});

server.setRequestHandler(ListToolsRequestSchema, async () => ({
  tools: [{
    name:        'get_weather',
    description: 'Get current weather for a city. Returns temperature, humidity, and conditions.',
    inputSchema: {
      type: 'object',
      properties: {
        city:  { type: 'string', description: 'City name' },
        units: { type: 'string', enum: ['celsius', 'fahrenheit'] },
      },
      required: ['city'],   // always list required — LLM omits params not listed here
    },
  }],
}));

server.setRequestHandler(CallToolRequestSchema, async (req) => {
  if (req.params.name !== 'get_weather') {
    // Return error as content — never throw; the MCP client must receive a structured response
    return { content: [{ type: 'text', text: \`Unknown tool: \${req.params.name}\` }], isError: true };
  }

  const parsed = GetWeatherSchema.safeParse(req.params.arguments);
  if (!parsed.success) {
    return {
      content: [{ type: 'text', text: \`Invalid input: \${parsed.error.message}\` }],
      isError: true,
    };
  }

  const weather = await fetchWeather(parsed.data.city, parsed.data.units);
  return { content: [{ type: 'text', text: JSON.stringify(weather) }] };
});

await server.connect(new StdioServerTransport());

declare function fetchWeather(city: string, units: string): Promise<object>;
`.trim();

// ── Server: Resource primitive ────────────────────────────────────────────────
const mcpResourcesCode = `
import { Server } from '@modelcontextprotocol/sdk/server/index.js';
import {
  ListResourcesRequestSchema,
  ReadResourceRequestSchema,
} from '@modelcontextprotocol/sdk/types.js';

// URI scheme reflects the data domain:
//   product://  →  product catalog data
//   config://   →  server-side configuration
//   customer:// →  per-customer records (embed id in path: customer://id/123)
const RESOURCE_MANIFEST = [
  {
    uri:         'product://catalog',
    name:        'Product catalog',
    description: 'All active products with prices and SKUs. Refreshed nightly.',
    mimeType:    'application/json',
  },
  {
    uri:         'config://pricing-rules',
    name:        'Pricing rules',
    description: 'Current discount tiers and minimum order quantities.',
    mimeType:    'application/json',
  },
];

server.setRequestHandler(ListResourcesRequestSchema, async () => ({
  resources: RESOURCE_MANIFEST,
}));

server.setRequestHandler(ReadResourceRequestSchema, async (req) => {
  const { uri } = req.params;

  if (uri === 'product://catalog') {
    // Paginate large datasets — returning 50 000 rows overflows the context window
    const rows = await db.query(
      'SELECT sku, name, price, stock FROM products WHERE active = 1 LIMIT 500',
    );
    return {
      contents: [{ uri, mimeType: 'application/json', text: JSON.stringify(rows) }],
    };
  }

  if (uri === 'config://pricing-rules') {
    return {
      contents: [{ uri, mimeType: 'application/json', text: JSON.stringify(PRICING_RULES) }],
    };
  }

  throw new Error(\`Resource not found: \${uri}\`);
});

declare const server: Server;
declare const db: { query: (sql: string) => Promise<object[]> };
declare const PRICING_RULES: object;
`.trim();

// ── Server: Prompt Template primitive ────────────────────────────────────────
const mcpPromptsCode = `
import { ListPromptsRequestSchema, GetPromptRequestSchema } from '@modelcontextprotocol/sdk/types.js';

// Templates live server-side — update once, both Chat and Email Specialists pick it up.
// No code deploy required when wording changes.
server.setRequestHandler(ListPromptsRequestSchema, async () => ({
  prompts: [
    {
      name:        'order-confirmation',
      description: 'Customer-facing order confirmation message.',
      arguments: [
        { name: 'customer_name', required: true  },
        { name: 'order_id',      required: true  },
        { name: 'items',         required: true  },
        { name: 'total',         required: true  },
        { name: 'channel',       required: false, description: 'chat | email — adjusts word count' },
      ],
    },
    {
      name:        'low-stock-alert',
      description: 'Internal alert when a product falls below the reorder threshold.',
      arguments: [
        { name: 'product',   required: true },
        { name: 'qty',       required: true },
        { name: 'threshold', required: true },
      ],
    },
  ],
}));

server.setRequestHandler(GetPromptRequestSchema, async (req) => {
  const { name, arguments: args = {} } = req.params;
  const a = args as Record<string, string>;

  if (name === 'order-confirmation') {
    const maxWords = a.channel === 'chat' ? '60' : '120';
    return {
      description: 'Order confirmation',
      messages: [{
        role: 'user',
        content: {
          type: 'text',
          // Note: task-focused — describes WHAT to write, not WHO the agent is.
          // Role and identity belong in the calling agent's system prompt, not here.
          text: \`Write a professional order confirmation.
Customer: \${a.customer_name}  Order #: \${a.order_id}
Items: \${a.items}  Total: $\${a.total}
Under \${maxWords} words. Warm and professional. Include an estimated delivery note.\`,
        },
      }],
    };
  }

  if (name === 'low-stock-alert') {
    return {
      description: 'Low-stock internal alert',
      messages: [{
        role: 'user',
        content: {
          type: 'text',
          text: \`Write a concise internal stock alert:
Product: \${a.product}  Current: \${a.qty} units (threshold: \${a.threshold})
Recommend reorder urgency (low / medium / high) and suggested quantity.\`,
        },
      }],
    };
  }

  throw new Error(\`Unknown prompt: \${name}\`);
});

declare const server: Server;
`.trim();

// ── Server: HTTP+SSE transport ────────────────────────────────────────────────
const httpServerCode = `
// Use HTTP+SSE when: multiple agent instances share one server, or it's a deployed microservice.
import express from 'express';
import { Server }             from '@modelcontextprotocol/sdk/server/index.js';
import { SSEServerTransport } from '@modelcontextprotocol/sdk/server/sse.js';
import { ListToolsRequestSchema, CallToolRequestSchema } from '@modelcontextprotocol/sdk/types.js';

const app    = express();
const server = new Server(
  { name: 'sales-tools-server', version: '1.0.0' },
  { capabilities: { tools: {} } },
);

// Handlers are IDENTICAL to the stdio version — transport is transparent to your logic
server.setRequestHandler(ListToolsRequestSchema, async () => ({
  tools: [
    { name: 'check_inventory', description: 'Check stock for a SKU.',
      inputSchema: { type: 'object', properties: { sku: { type: 'string' } }, required: ['sku'] } },
  ],
}));
server.setRequestHandler(CallToolRequestSchema, async (req) => {
  if (req.params.name === 'check_inventory') {
    const stock = await inventory.check((req.params.arguments as { sku: string }).sku);
    return { content: [{ type: 'text', text: JSON.stringify({ available: stock }) }] };
  }
  return { content: [{ type: 'text', text: \`Unknown: \${req.params.name}\` }], isError: true };
});

// One SSEServerTransport per connected client session
const sessions = new Map<string, SSEServerTransport>();

// Client opens persistent SSE stream here
app.get('/sse', async (req, res) => {
  const transport = new SSEServerTransport('/message', res);
  sessions.set(transport.sessionId, transport);
  res.on('close', () => sessions.delete(transport.sessionId));
  await server.connect(transport);
});

// Client sends requests here; sessionId ties message to the SSE stream
app.post('/message', express.json(), async (req, res) => {
  const transport = sessions.get(req.query.sessionId as string);
  if (!transport) { res.status(404).json({ error: 'Session not found' }); return; }
  await transport.handlePostMessage(req, res);
});

app.listen(3100, () => console.log('MCP server on :3100'));

declare const inventory: { check: (sku: string) => Promise<number> };
`.trim();

