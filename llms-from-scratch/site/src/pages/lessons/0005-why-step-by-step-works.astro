const scratchpad = `
17 × 20 = 340
17 × 4  = 68
340 + 68 = 408
`.trim();

const spikeTrace = `
Step 1: Identify the largest spike.
Product 5 on 2024-01-12 sold 342 units, compared with roughly 100 on other days.
`.trim();

const mindMap = `
# Why “Think Step by Step” Works
## Next-token prediction
### Output format, not the whole process
### Each token sees the whole context
## Why steps help
### Fixed compute per token
### Written tokens = working memory
### Prompt shifts likely continuations
## Attention
### Query · key → softmax → values
